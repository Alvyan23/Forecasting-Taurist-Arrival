    "            if norm_xlsx and os.path.exists(norm_xlsx):\n",
    "                with st.expander(\"Lihat Ringkasan Nilai Min & Max Notebook (Excel)\"):\n",
    "                    try:\n",
    "                        df_n = pd.read_excel(norm_xlsx, sheet_name=\"Ringkasan_MinMax\", header=2)\n",
