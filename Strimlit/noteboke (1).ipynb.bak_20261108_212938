    "                   \"Akan ditangani dengan interpolasi linear.\")\n",
    "    else:\n",
    "        st.success(\"Tidak ada nilai 0 pada data.\")\n",
    "    pra = proses_interpolasi(raw_df)\n",
    "    data_clean = pd.DataFrame({\"date\": pra[\"dates\"], \"visitors\": pra[\"clean\"]})\n",
    "    return raw_df, data_clean\n",
