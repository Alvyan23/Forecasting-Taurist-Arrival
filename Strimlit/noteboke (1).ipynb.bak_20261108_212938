    "               style=\"filter:drop-shadow(0 3px 3px rgba(0,0,0,.35));\">\n",
    "            <path d=\"M15 0C6.7 0 0 6.7 0 15c0 11 15 27 15 27s15-16 15-27C30 6.7 23.3 0 15 0z\"\n",
    "                  fill=\"{d['color']}\" stroke=\"white\" stroke-width=\"2\"/>\n",
