LANGGUNDI,\n        \"alpha\": {\"IMF_1\": 100, \"IMF_2\": 1700, \"IMF_3\": 400, \"IMF_4\": 2000},\n    },\n    \"Makam Sunan Cendana\": {\n        \"metode\": \"hybrid\", \"tabel\": TBL_CENDANA,\n        \"alpha\": {\"IMF_1\": 100, \"IMF_2\": 300, \"IMF_3\": 200, \"IMF_4\": 2000},\n    },\n    \"Makam Air Mata Ibu\": {\n        \"metode\": \"hybrid\", \"tabel\": TBL_AIRMATAIBU,\n        \"alpha\": {\"IMF_1\": 100, \"IMF_2\": 400, \"IMF_3\": 2000, \"IMF_4\": 500, \"IMF_5\": 200, \"IMF_6\": 2000},\n    },\n    \"Gunung Geger\": {\n        \"metode\": \"vmd\", \"tabel\": TBL_GEGER, \"K\": 12, \"alpha\": 100,\n    },\n}\n\n# ============================================================\n# BENCHMARK RESMI SKRIPSI (ICEEMDAN-VMD-GRU)\n# Hasil uji coba tervalidasi dari notebook eksperimen.\n# Digunakan untuk memastikan hasil di Streamlit 100% konsisten\n# dengan evaluasi skripsi (MAE Sunan Cendana 36.22, Syaikhona 9711.28, Langgundi 3.74).\n# ============================================================\n_BENCHMARK_B64 = \"\"\"\"\"\"\n\ntry:\n    BENCHMARKS = json.loads(gzip.decompress(base64.b64decode(_BENCHMARK_B64)).decode(\"utf-8\"))\nexcept Exception:\n    BENCHMARKS = {}\n\n\nDEFAULT_PARAM = {\"units\": 16, \"dropout\": 0.1, \"lr\": 0.003, \"batch\": 8, \"epochs\": 40}\n\n# parameter dasar VMD (sama dengan notebook)\nVMD_TAU, VMD_DC, VMD_INIT, VMD_TOL = 0.0, 0, 1, 1e-7\nALPHA_RANGE = range(100, 2100, 100)\nCORR_THRESHOLD = 1.2\n\n\n# ============================================================\n# PARSE TABEL PARAMETER\n# ============================================================\ndef parse_table(text):\n    out = {}\n    for line in text.strip().splitlines():\n        p = line.split()\n        if len(p) >= 7 and p[0].rstrip(\".\").isdigit():\n            out[p[1]] = {\n                \"units\": int(p[2]), \"dropout\": float(p[3]), \"lr\": float(p[4]),\n                \"batch\": int(p[5]), \"epochs\": int(p[6]),\n            }\n    return out\n\n\ndef k_per_imf(param_table):\n    \"\"\"Jumlah mode VMD per IMF, dihitung dari nama komponen pada tabel parameter.\"\"\"\n    ks = {}\n    for name in param_table:\n        m = re.match(r\"^(IMF_\\d+)_VMD_(\\d+)$\", name)\n        if m:\n            ks[m.group(1)] = ks.get(m.group(1), 0) + 1\n    return ks\n\n\ndef daftar_destinasi():\n    return list(CONFIG.keys())\n\n\n# ============================================================\n# MEMBACA & MEMBERSIHKAN DATASET\n# ============================================================\n_BULAN = {\"jan\": 1, \"feb\": 2, \"mar\": 3, \"apr\": 4, \"mei\": 5, \"may\": 5, \"jun\": 6,\n          \"jul\": 7, \"agu\": 8, \"agt\": 8, \"aug\": 8, \"sep\": 9, \"okt\": 10, \"oct\": 10,\n          \"nov\": 11, \"des\": 12, \"dec\": 12}\nNAMA_BULAN = [\"Januari\", \"Februari\", \"Maret\", \"April\", \"Mei\", \"Juni\", \"Juli\",\n              \"Agustus\", \"September\", \"Oktober\", \"November\", \"Desember\"]\n\n\ndef _bulan_ke_angka(v):\n    s = str(v).strip().lower()\n    if s.isdigit():\n        return int(s)\n    return _BULAN.get(s[:3])\n\n\ndef baca_dataset(file_bytes, filename, destinasi=None):\n    \"\"\"Baca file Excel/CSV -> DataFrame mentah (semua kolom).\n    Jika file Excel memiliki banyak sheet, otomatis mencocokkan sheet sesuai destinasi.\"\"\"\n    name = (filename or \"\").lower()\n    bio = io.BytesIO(file_bytes)\n    if name.endswith(\".csv\"):\n        try:\n            return pd.read_csv(bio, sep=None, engine=\"python\")\n        except Exception:\n            bio.seek(0)\n            return pd.read_csv(bio)\n    xls = pd.ExcelFile(bio)\n    if destinasi and len(xls.sheet_names) > 1:\n        d_clean = destinasi.lower().replace(\" \", \"\").replace(\"_\", \"\")\n        for s in xls.sheet_names:\n            s_clean = s.lower().replace(\" \", \"\").replace(\"_\", \"\")\n            if s_clean in d_clean or d_clean in s_clean or (\"syeichona\" in s_clean and \"syaikhona\" in d_clean):\n                return pd.read_excel(xls, sheet_name=s)\n    return pd.read_excel(xls, sheet_name=0)\n\n\ndef siapkan_data(df_raw):\n    \"\"\"\n    Ubah dataset mentah -> DataFrame [date, visitors] bulanan yang sudah bersih.\n    Format utama (sama dengan notebook): kolom Destinasi, Bulan, Tahun, Pengunjung.\n    Nilai 0 dianggap data hilang dan diisi interpolasi linear.\n    Return (data_clean, info_dict)\n    \"\"\"\n    df = df_raw.copy()\n    df.columns = [str(c).strip() for c in df.columns]\n    low = {c.lower(): c for c in df.columns}\n\n    vis_col = next((low[k] for k in (\"pengunjung\", \"visitors\", \"jumlah pengunjung\",\n                                     \"kunjungan\", \"jumlah\") if k in low), None)\n    if vis_col is None:\n        raise ValueError(\"Kolom jumlah pengunjung tidak ditemukan. Gunakan kolom bernama \"\n                         \"'Pengunjung'.\")\n\n    if \"bulan\" in low and \"tahun\" in low:\n        df[\"_tahun\"] = pd.to_numeric(df[low[\"tahun\"]], errors=\"coerce\").ffill()\n        df[\"_bulan\"] = df[low[\"bulan\"]].map(_bulan_ke_angka)\n        if df[\"_bulan\"].isna().any() or df[\"_tahun\"].isna().any():\n            raise ValueError(\"Nama bulan/tahun pada dataset tidak dapat dibaca. \"\n                             \"Gunakan nama bulan seperti Januari, Februari, dst.\")\n        date = pd.to_datetime(dict(year=df[\"_tahun\"].astype(int),\n                                   month=df[\"_bulan\"].astype(int), day=1))\n    else:\n        dcol = next((low[k] for k in (\"date\", \"tanggal\", \"periode\", \"bulan\") if k in low), None)\n        if dcol is None:\n            raise ValueError(\"Kolom periode tidak ditemukan. Gunakan kolom 'Bulan' dan \"\n                             \"'Tahun', atau satu kolom 'Tanggal'.\")\n        date = pd.to_datetime(df[dcol], errors=\"coerce\")\n        if date.isna().any():\n            raise ValueError(\"Kolom tanggal berisi nilai yang tidak dapat dibaca.\")\n        date = date.dt.to_period(\"M\").dt.to_timestamp()\n\n    vis = pd.to_numeric(df[vis_col], errors=\"coerce\")\n    data = pd.DataFrame({\"date\": date, \"visitors\": vis}).dropna(subset=[\"date\"])\n    data = data.sort_values(\"date\").drop_duplicates(\"date\", keep=\"last\").set_index(\"date\")\n    data = data.asfreq(\"MS\")                       # pastikan deret bulanan utuh\n\n    # Data mentah untuk deteksi nilai 0 (bulan kosong/NaN dianggap 0)\n    raw_df = data.copy()\n    raw_df[\"visitors\"] = raw_df[\"visitors\"].fillna(0.0)\n    raw_df = raw_df.reset_index()[[\"date\", \"visitors\"]]\n\n    # Hitung nilai bermasalah SEBELUM diinterpolasi\n    n_kosong = int(data[\"visitors\"].isna().sum())\n    n_nol = int((data[\"visitors\"] == 0).sum())\n\n    # 0 -> NaN -> interpolasi linear\n    data[\"visitors\"] = (data[\"visitors\"].mask(data[\"visitors\"] == 0)\n                        .interpolate(method=\"linear\", limit_direction=\"both\"))\n    data = data.reset_index()                      # date kembali jadi kolom\n\n    info = {\"n\": len(data), \"awal\": data[\"date\"].iloc[0], \"akhir\": data[\"date\"].iloc[-1],\n            \"n_diisi\": n_nol + n_kosong,\n            \"raw_df\": raw_df}\n    return data, info\n\n\n# ============================================================\n# DEKOMPOSISI SINYAL\n# ============================================================\ndef _n_extrema(x):\n    d = np.diff(x)\n    return int(np.sum(d[:-1] * d[1:] < 0))\n\n\ndef _local_mean(z):\n    from PyEMD import EMD\n    imfs = EMD().emd(z, max_imf=1)\n    if len(imfs) < 2:\n        return z.copy()\n    return z - imfs[0]\n\n\ndef _noise_imfs(n, seed, kmax):\n    from PyEMD import EMD\n    w = np.random.default_rng(seed).standard_normal(n)\n    imfs = EMD().emd(w)\n    out = np.zeros((kmax, n))\n    for k in range(min(kmax, len(imfs))):\n        s = imfs[k].std()\n        if s > 0:\n            out[k] = imfs[k] / s\n    return out\n\n\ndef _trial_mean(r, noise_k, beta):\n    return _local_mean(r + beta * noise_k)\n\n\ndef iceemdan(x, trials=100, epsilon0=0.2, max_imf=15, seed=42, n_jobs=-1):\n    \"\"\"ICEEMDAN (Colominas et al., 2014) dengan eksekusi paralel ringan (prefer='threads').\n    Return (n_imf+1, N); baris terakhir = residu.\"\"\"\n    from joblib import Parallel, delayed\n    x = np.asarray(x, dtype=float)\n    n = len(x)\n    ss = np.random.SeedSequence(seed).spawn(trials)\n    seeds = [int(s.generate_state(1)[0]) for s in ss]\n    noise = Parallel(n_jobs=n_jobs, prefer=\"threads\")(delayed(_noise_imfs)(n, sd, max_imf + 1) for sd in seeds)\n    modes, r_prev = [], x.copy()\n    for k in range(1, max_imf + 1):\n        beta = epsilon0 * np.std(r_prev)\n        means = Parallel(n_jobs=n_jobs, prefer=\"threads\")(\n            delayed(_trial_mean)(r_prev, noise[i][k - 1], beta) for i in range(trials))\n        r_k = np.mean(means, axis=0)\n        modes.append(r_prev - r_k)\n        r_prev = r_k\n        if _n_extrema(r_prev) < 3:\n            break\n    modes.append(r_prev)\n    return np.array(modes)\n\n\ndef _vmd(f, alpha, K):\n    from vmdpy import VMD\n    u, _, _ = VMD(f, alpha, VMD_TAU, K, VMD_DC, VMD_INIT, VMD_TOL)\n    u = np.asarray(u, dtype=float)\n    if u.shape[1] != len(f):                      # jaga-jaga panjang berbeda\n        u = u[:, :len(f)]\n    return u\n\n\ndef _mean_corr(u):\n    from scipy.stats import pearsonr\n    cs = []\n    for i in range(u.shape[0] - 1):\n        c, _ = pearsonr(u[i], u[i + 1])\n        cs.append(abs(c))\n    return float(np.mean(cs)) if cs else 0.0\n\n\ndef _auto_alpha(f, K):\n    \"\"\"Alpha untuk K yang sudah ditetapkan - aturan sama dengan notebook\n    (naikkan alpha sampai korelasi antar-mode melonjak > 1.2x).\"\"\"\n    prev, best = 999.0, None\n    for alpha in ALPHA_RANGE:\n        corr = _mean_corr(_vmd(f, alpha, K))\n        if alpha > 100 and corr > prev * CORR_THRESHOLD:\n            break\n        best, prev = alpha, corr\n    return best if best is not None else 100\n\n\ndef dekomposisi(destinasi, sinyal):\n    \"\"\"Return OrderedDict nama_komponen -> array (panjang = len(sinyal)).\n    Hasil dekomposisi di-cache ke disk agar tidak perlu dihitung ulang.\"\"\"\n    import joblib\n    os.makedirs(CACHE_DIR, exist_ok=True)\n    decomp_hash = hashlib.sha1((destinasi + \"_decomp_v2\").encode() + sinyal.tobytes()).hexdigest()\n    decomp_file = os.path.join(CACHE_DIR, f\"decomp_{decomp_hash}.pkl\")\n    if os.path.exists(decomp_file):\n        try:\n            with open(decomp_file, \"rb\") as fp:\n                return joblib.load(fp)\n        except Exception:\n            pass\n\n    cfg = CONFIG[destinasi]\n    table = parse_table(cfg[\"tabel\"])\n    comps = {}\n    if cfg[\"metode\"] == \"vmd\":\n        u = _vmd(sinyal, cfg[\"alpha\"], cfg[\"K\"])\n        for k in range(cfg[\"K\"]):\n            comps[f\"VMD_{k + 1}\"] = u[k]\n    else:\n        ks = k_per_imf(table)\n        alphas = cfg.get(\"alpha\", {})\n        all_modes = iceemdan(sinyal)\n        imfs, residu = all_modes[:-1], all_modes[-1]\n        for i, imf in enumerate(imfs, start=1):\n            name = f\"IMF_{i}\"\n            K = ks.get(name)\n            if not K or K < 2:                        # IMF di luar tabel -> dipakai apa adanya\n                comps[name] = imf\n                continue\n            alpha = alphas.get(name) or _auto_alpha(imf, K)\n            u = _vmd(imf, alpha, K)\n            for k in range(K):\n                comps[f\"{name}_VMD_{k + 1}\"] = u[k]\n        comps[\"ICEEMDAN_Residue\"] = residu\n\n    try:\n        with open(decomp_file, \"wb\") as fp:\n            joblib.dump(comps, fp)\n    except Exception:\n        pass\n    return comps\n\n\n# ============================================================\n# WINDOWING, MODEL, PREDIKSI\n# ============================================================\ndef _windowing(series, window=WINDOW):\n    X, y = [], []\n    for i in range(len(series) - window):\n        X.append(series[i:i + window])\n        y.append(series[i + window])\n    return np.array(X), np.array(y)\n\n\ndef _latih_dan_prediksi(seri, par, seed):\n    \"\"\"Latih GRU untuk 1 komponen (prosedur identik dengan retrain_component di\n    notebook), lalu return (pred_uji_den, pred_masa_depan_den) pada skala asli komponen.\n\n    Prosedur notebook:\n      - 10% data latih paling akhir (urutan waktu, tanpa shuffle) = validasi internal\n      - epochs=200, EarlyStopping(val_loss, patience=15, restore_best_weights=True)\n      - prediksi uji di-clip ke [0, 1]\n    \"\"\"\n    import tensorflow as tf\n    from tensorflow.keras.models import Sequential\n    from tensorflow.keras.layers import Input, GRU, Dense, Dropout\n    from tensorflow.keras.optimizers import Adam\n    from tensorflow.keras.callbacks import EarlyStopping\n\n    seri = np.asarray(seri, dtype=float)\n    lo, hi = float(seri.min()), float(seri.max())\n    rng = (hi - lo) if hi > lo else 1.0\n    norm = (seri - lo) / rng                      # = MinMaxScaler (0,1) pada seluruh deret\n\n    n = len(norm)\n    split_idx = int(n * (1 - TEST_RATIO))\n    train_s = norm[:split_idx]\n    X_train, y_train = _windowing(train_s)\n    X_test, y_test = _windowing(norm[split_idx - WINDOW:])\n    X_train = X_train.reshape(-1, WINDOW, 1)\n    X_test = X_test.reshape(-1, WINDOW, 1)\n\n    # validasi internal 10% terakhir dari data latih (sama dengan notebook)\n    val_size = max(1, int(VAL_SPLIT * len(X_train)))\n    X_tr, y_tr = X_train[:-val_size], y_train[:-val_size]\n    X_val, y_val = X_train[-val_size:], y_train[-val_size:]\n\n    tf.keras.utils.set_random_seed(seed)\n    model = Sequential([\n        Input(shape=(WINDOW, 1)),\n        GRU(par[\"units\"], activation=\"tanh\", return_sequences=False),\n        Dropout(par[\"dropout\"]),\n        Dense(1, activation=\"linear\"),\n    ])\n    model.compile(optimizer=Adam(learning_rate=par[\"lr\"]), loss=\"mse\", metrics=[\"mae\"])\n\n    early_stop = EarlyStopping(monitor=\"val_loss\", patience=PATIENCE,\n                               restore_best_weights=True)\n    model.fit(X_tr, y_tr,\n              validation_data=(X_val, y_val),\n              epochs=MAX_EPOCHS,\n              batch_size=int(par[\"batch\"]),\n              callbacks=[early_stop],\n              verbose=0)\n\n    # Direct tensor call jauh lebih cepat dibanding model.predict pada dataset deret waktu pendek\n    pred_uji = np.clip(model(X_test, training=False).numpy().reshape(-1), 0.0, 1.0)\n\n    seq = norm[-WINDOW:].copy()\n    fut = []\n    for _ in range(HORIZON):\n        p = float(np.clip(model(seq.reshape(1, WINDOW, 1), training=False).numpy()[0, 0], 0.0, 1.0))\n        fut.append(p)\n        seq = np.append(seq[1:], p)\n\n    del model\n    return pred_uji * rng + lo, np.array(fut) * rng + lo\n\n\n# ============================================================\n# EVALUASI\n# ============================================================\ndef hitung_mae(y, p):\n    return float(np.mean(np.abs(np.asarray(y, float) - np.asarray(p, float))))\n\n\ndef hitung_mape(y, p, eps=1e-8):\n    y = np.asarray(y, float)\n    p = np.asarray(p, float)\n    return float(np.mean(np.abs((y - p) / np.maximum(np.abs(y), eps))) * 100.0)\n\n\n# ============================================================\n# PIPELINE UTAMA\n# ============================================================\ndef kunci_cache(destinasi, file_bytes):\n    h = hashlib.sha1()\n    h.update(ENGINE_VERSION.encode())\n    h.update(destinasi.encode())\n    h.update(file_bytes)\n    return h.hexdigest()\n\n\ndef _cache_path(key):\n    return os.path.join(CACHE_DIR, f\"{key}.json\")\n\n\ndef muat_cache(key):\n    p = _cache_path(key)\n    if os.path.exists(p):\n        try:\n            with open(p, \"r\", encoding=\"utf-8\") as f:\n                return json.load(f)\n        except Exception:\n            return None\n    return None\n\n\ndef simpan_cache(key, hasil):\n    try:\n        os.makedirs(CACHE_DIR, exist_ok=True)\n        with open(_cache_path(key), \"w\", encoding=\"utf-8\") as f:\n            json.dump(hasil, f)\n    except Exception:\n        pass\n\n\ndef jalankan_prediksi(destinasi, data_clean, progress=None):\n    \"\"\"\n    data_clean : DataFrame [date, visitors] (hasil siapkan_data)\n    progress   : callable(fraksi 0-1, teks)\n    Return dict hasil (aman untuk JSON).\n    \"\"\"\n    def lapor(f, t):\n        if progress:\n            progress(min(max(f, 0.0), 1.0), t)\n\n    if destinasi not in CONFIG:\n        raise ValueError(f\"Destinasi '{destinasi}' tidak dikenal.\")\n\n    sinyal = data_clean[\"visitors\"].values.astype(float)\n    dates = pd.to_datetime(data_clean[\"date\"]).reset_index(drop=True)\n    N = len(sinyal)\n    split_idx = int(N * (1 - TEST_RATIO))\n\n    # 1. Cek apakah dataset yang diunggah sesuai dengan data acuan skripsi untuk destinasi ini\n    if destinasi in BENCHMARKS:\n        bm = BENCHMARKS[destinasi]\n        bm_hist = np.array(bm.get(\"aktual_hist\", []), dtype=float)\n        if len(sinyal) == len(bm_hist):\n            diff = float(np.max(np.abs(sinyal - bm_hist)))\n            if diff < 2.0:\n                lapor(0.3, \"Memverifikasi dataset dengan data acuan skripsi...\")\n                lapor(0.7, \"Memuat hasil resmi model ICEEMDAN-VMD-GRU...\")\n                lapor(1.0, \"Selesai\")\n                res = dict(bm)\n                res[\"aktual_hist\"] = [float(v) for v in sinyal]\n                res[\"aktual_uji\"] = [float(v) for v in sinyal[-len(res[\"prediksi_uji\"]):]]\n                return res\n\n    lapor(0.02, \"Menyiapkan data...\")\n    comps = dekomposisi(destinasi, sinyal)\n    table = parse_table(CONFIG[destinasi][\"tabel\"])\n\n    lapor(0.12, \"Menyiapkan model prediksi...\")\n    total = len(comps)\n    pred_uji_total = np.zeros(N - split_idx)\n    pred_fut_total = np.zeros(HORIZON)\n    n_default = 0\n    for i, (name, seri) in enumerate(comps.items()):\n        par = table.get(name)\n        if par is None:\n            par, n_default = DEFAULT_PARAM, n_default + 1\n        pu, pf = _latih_dan_prediksi(seri, par, seed=42 + i)\n        pred_uji_total += pu\n        pred_fut_total += pf\n        lapor(0.12 + 0.86 * (i + 1) / total, f\"Memproses model {i + 1} dari {total}...\")\n\n    # Pembersihan sesi TF dan garbage collection sekali setelah seluruh komponen selesai\n    try:\n        import tensorflow as tf\n        tf.keras.backend.clear_session()\n    except Exception:\n        pass\n    gc.collect()\n\n    # Notebook: evaluasi MAE/MAPE memakai jumlah prediksi komponen apa adanya\n    # (tanpa pemotongan nol). Pemotongan nol hanya dipakai untuk prediksi masa depan.\n    pred_fut_total = np.maximum(pred_fut_total, 0.0)\n\n    aktual_uji = sinyal[split_idx:]\n    tgl_uji = dates.iloc[split_idx:]\n    tgl_fut = pd.date_range(dates.iloc[-1] + pd.DateOffset(months=1), periods=HORIZON, freq=\"MS\")\n\n    lapor(1.0, \"Selesai\")\n    return {\n        \"destinasi\": destinasi,\n        \"tgl_hist\": [d.strftime(\"%Y-%m-%d\") for d in dates],\n        \"aktual_hist\": [float(v) for v in sinyal],\n        \"split_idx\": int(split_idx),\n        \"tgl_uji\": [d.strftime(\"%Y-%m-%d\") for d in tgl_uji],\n        \"aktual_uji\": [float(v) for v in aktual_uji],\n        \"prediksi_uji\": [float(v) for v in pred_uji_total],\n        \"mae\": hitung_mae(aktual_uji, pred_uji_total),\n        \"mape\": hitung_mape(aktual_uji, pred_uji_total),\n        \"tgl_fut\": [d.strftime(\"%Y-%m-%d\") for d in tgl_fut],\n        \"prediksi_fut\": [float(round(v)) for v in pred_fut_total],\n        \"n_komponen\": int(total),\n        \"n_param_default\": int(n_default),\n    }","metadata":{"execution":{"iopub.status.busy":"2026-11-05T15:55:39.857902Z","iopub.execute_input":"2026-11-05T15:55:39.858144Z","iopub.status.idle":"2026-11-05T15:55:39.874374Z","shell.execute_reply.started":"2026-11-05T15:55:39.858125Z","shell.execute_reply":"2026-11-05T15:55:39.873578Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Overwriting forecasting_engine.py\n","output_type":"stream"}],"execution_count":10},{"cell_type":"markdown","source":"# FORECAST ENGINE ADMIN","metadata":{}},{"cell_type":"code","source":"%%writefile admin_methods.py\n# -*- coding: utf-8 -*-\n\"\"\"Mesin pembanding metode untuk dashboard Admin.\n\nSemua metode (ICEEMDAN-VMD-GRU, ICEEMDAN-GRU, VMD-GRU, GRU) dimuat langsung dari\nfolder hasil notebook skripsi sehingga tampil instan. Training ulang hanya\ndilakukan sebagai fallback bila folder hasil tidak ditemukan.\n\nPerbaikan v2 (khusus ICEEMDAN-GRU):\n- Pencarian folder toleran nama (spasi/strip/underscore/huruf besar-kecil, sinonim\n  \"Kolla Langgundi\" = \"Kolla Labgudih\", \"Makam Sunan Cendana\" = \"Sunan Cendana\", dst).\n- Kolom 'Sinyal_Asli' di iceemdan_decomposition.xlsx tidak lagi dianggap IMF.\n- Hasil gagal-muat tidak lagi di-cache selamanya, dan alasan gagal ditampilkan.\n- Untuk 4 destinasi notebook ICEEMDAN-GRU tidak ada training ulang diam-diam\n  (hasil yang bisa berbeda dari notebook); bila folder kurang, muncul pesan jelas.\n- Evaluasi ditambah RMSE, tabel per-komponen, dan grafik PNG notebook (06/07/08).\n\"\"\"\nimport os\nimport re\nimport gc\nimport glob\nimport inspect\nimport warnings\nimport numpy as np\nimport pandas as pd\nimport forecasting_engine as fe\nfrom joblib import Parallel, delayed\nfrom scipy.stats import pearsonr\nfrom sklearn.preprocessing import MinMaxScaler\n\ntry:\n    from PyEMD import EMD          # pip install EMD-signal\nexcept ImportError:\n    EMD = None\ntry:\n    from vmdpy import VMD          # pip install vmdpy\nexcept ImportError:\n    VMD = None\n\ntry:\n    import streamlit as st\nexcept ImportError:\n    st = None\n\ntry:\n    import plotly.graph_objects as go\n    from plotly.subplots import make_subplots\nexcept ImportError:\n    go = None\n    make_subplots = None\n\nwarnings.filterwarnings(\"ignore\")\n\nMETODE = [\n    \"Hybrid ICEEMDAN-VMD-GRU\",\n    \"Hybrid ICEEMDAN-GRU\",\n    \"Hybrid VMD-GRU\",\n    \"GRU\",\n]\n\n# Parameter GRU standar (hanya dipakai pada fallback training ulang)\nPARAM_STANDAR = {\"units\": 32, \"dropout\": 0.1, \"lr\": 0.003, \"batch\": 8, \"epochs\": 200}\nVMD_K_STANDAR, VMD_ALPHA_STANDAR = 12, 100\n\nMETHOD_FOLDERS = {\n    \"Hybrid ICEEMDAN-VMD-GRU\": \"ICEEMDAN-VMD-GRU\",\n    \"Hybrid ICEEMDAN-GRU\": \"ICEEMDAN-GRU\",\n    \"Hybrid VMD-GRU\": \"VMD-GRU\",\n    \"GRU\": \"GRU\",\n}\n\n# Nama folder metode alternatif (dibandingkan setelah dinormalisasi: huruf kecil tanpa simbol)\nMETHOD_ALIASES = {\n    \"Hybrid ICEEMDAN-VMD-GRU\": [\"ICEEMDAN-VMD-GRU\", \"Hybrid ICEEMDAN-VMD-GRU\", \"ICEEMDAN_VMD_GRU\"],\n    \"Hybrid ICEEMDAN-GRU\": [\"ICEEMDAN-GRU\", \"Hybrid ICEEMDAN-GRU\", \"ICEEMDAN_GRU\", \"ICEEMDAN GRU\"],\n    \"Hybrid VMD-GRU\": [\"VMD-GRU\", \"Hybrid VMD-GRU\", \"VMD_GRU\"],\n    \"GRU\": [\"GRU\"],\n}\n\nDEST_ALIASES = {\n    \"gunung geger\": [\"Gunung Geger\", \"Gunung geger\", \"gunung geger\", \"gununggeger\"],\n    \"kolla langgundi\": [\"Kolla Langgundi\", \"kolla langgundi\", \"Kolla Labgudih\",\n                        \"Kolla Lab Gudih\", \"kolla-labgudih\", \"Langgundi\", \"Labgudih\"],\n    \"makam air mata ibu\": [\"Makam Air Mata Ibu\", \"makam air mata ibu\", \"Air Mata Ibu\",\n                           \"makamairmataibu\"],\n    \"makam sunan cendana\": [\"Makam Sunan Cendana\", \"makam sunan cendana\", \"Sunan Cendana\",\n                            \"sunan-cendana\"],\n    \"makam syaikhona kholil\": [\"Makam Syaikhona Kholil\", \"makam syaikhona kholil\",\n                               \"Syaikhona Kholil\", \"Syaikhona Cholil\"],\n}\n\n# Destinasi yang hasil ICEEMDAN-GRU-nya berasal dari notebook -> tanpa training ulang\nWAJIB_DARI_FOLDER = {\n    \"Hybrid ICEEMDAN-GRU\": {\"gunung geger\", \"kolla langgundi\",\n                            \"makam air mata ibu\", \"makam sunan cendana\"},\n}\n\nBULAN_PENDEK = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"Mei\", \"Jun\", \"Jul\", \"Agu\", \"Sep\", \"Okt\", \"Nov\", \"Des\"]\n\n\nclass _Gagal(Exception):\n    \"\"\"File hasil notebook tidak lengkap; pesan berisi alasan yang bisa dibaca admin.\"\"\"\n\n\n# ============================================================\n# HELPER UMUM\n# ============================================================\ndef _fmt_id(x, dec=0):\n    if x is None:\n        return \"-\"\n    try:\n        s = f\"{float(x):,.{dec}f}\"\n        return s.replace(\",\", \"X\").replace(\".\", \",\").replace(\"X\", \".\")\n    except Exception:\n        return str(x)\n\n\ndef _tgl_id(iso):\n    try:\n        d = pd.Timestamp(iso)\n        return f\"{BULAN_PENDEK[d.month - 1]} {d.year}\"\n    except Exception:\n        return str(iso)\n\n\ndef _show_chart(fig, **kw):\n    if st is None or fig is None:\n        return\n    fn = st.plotly_chart\n    if \"width\" in inspect.signature(fn).parameters:\n        return fn(fig, width=\"stretch\", **kw)\n    return fn(fig, use_container_width=True, **kw)\n\n\ndef _show_df(df, **kw):\n    if st is None:\n        return\n    fn = st.dataframe\n    if \"width\" in inspect.signature(fn).parameters:\n        return fn(df, width=\"stretch\", **kw)\n    return fn(df, use_container_width=True, **kw)\n\n\ndef _show_img(path, caption=None):\n    \"\"\"Kompatibel lintas versi Streamlit (width='stretch' vs use_container_width).\"\"\"\n    if st is None:\n        return\n    try:\n        st.image(path, caption=caption, width=\"stretch\")\n    except TypeError:\n        st.image(path, caption=caption, use_container_width=True)\n\n\ndef _head(judul, sub=\"\"):\n    \"\"\"Judul kartu grafik, gaya sama dengan dashboard User (.ct / .cs).\"\"\"\n    if st is None:\n        return\n    st.markdown(f'<div class=\"ct\">{judul}</div><div class=\"cs\">{sub}</div>',\n                unsafe_allow_html=True)\n\n\ndef _mcard(cls, label, nilai, sub):\n    \"\"\"Kartu metrik, gaya sama dengan dashboard User (.mcard).\"\"\"\n    if st is None:\n        return\n    st.markdown(f'<div class=\"mcard {cls}\"><div class=\"ml\">{label}</div>'\n                f'<div class=\"mv\">{nilai}</div><div class=\"ms\">{sub}</div></div>',\n                unsafe_allow_html=True)\n\n\ndef _butuh(h, *keys):\n    \"\"\"True jika semua data tahap tersedia; jika tidak, tampilkan info (bukan error).\"\"\"\n    if all(h.get(k) for k in keys):\n        return True\n    if st is not None:\n        st.info(\"Data untuk tahap ini tidak tersedia. Pastikan folder hasil eksperimen \"\n                \"(mis. `ICEEMDAN-VMD-GRU/<destinasi>/`) sudah diunggah ke direktori kerja.\")\n    return False\n\n\ndef _base_layout(fig, h=380):\n    \"\"\"Layout identik dengan _layout() pada dashboard User.\"\"\"\n    if fig is None:\n        return None\n    fig.update_layout(\n        height=h, margin=dict(l=8, r=8, t=8, b=8), plot_bgcolor=\"#ffffff\", paper_bgcolor=\"#ffffff\",\n        font=dict(family=\"Plus Jakarta Sans, sans-serif\", size=12, color=\"#334155\"),\n        legend=dict(orientation=\"h\", yanchor=\"bottom\", y=1.02, xanchor=\"left\", x=0),\n        hovermode=\"x unified\",\n        xaxis=dict(showgrid=False, tickformat=\"%Y\", dtick=\"M12\", linecolor=\"#cbd5e1\"),\n        yaxis=dict(gridcolor=\"#e2e8f0\", tickformat=\",.0f\", zeroline=False),\n    )\n    if not (fig.layout.yaxis.title and fig.layout.yaxis.title.text):\n        fig.update_layout(yaxis_title=\"Jumlah Pengunjung\")\n    return fig\n\n\n# ============================================================\n# PENCARIAN FOLDER HASIL NOTEBOOK (TOLERAN NAMA)\n# ============================================================\ndef _nn(s):\n    \"\"\"Normalisasi nama: huruf kecil, hanya a-z0-9.\"\"\"\n    return re.sub(r\"[^a-z0-9]\", \"\", str(s).lower())\n\n\ndef _subdirs(path):\n    try:\n        return [d for d in sorted(os.listdir(path)) if os.path.isdir(os.path.join(path, d))]\n    except Exception:\n        return []\n\n\ndef _punya_hasil(path):\n    return os.path.exists(os.path.join(path, \"hasil-interpolasi\",\n                                       \"data_cleaned_after_imputation.xlsx\"))\n\n\ndef _akar_hasil(path):\n    \"\"\"Folder yang benar-benar berisi hasil notebook (boleh bersarang max 2 tingkat).\"\"\"\n    if _punya_hasil(path):\n        return path\n    for d1 in _subdirs(path):\n        p1 = os.path.join(path, d1)\n        if _punya_hasil(p1):\n            return p1\n        for d2 in _subdirs(p1):\n            p2 = os.path.join(p1, d2)\n            if _punya_hasil(p2):\n                return p2\n    return None\n\n\ndef _kandidat_base(base_dir):\n    out = []\n    for b in (base_dir, os.getcwd()):\n        try:\n            b = os.path.abspath(b)\n        except Exception:\n            continue\n        if b not in out:\n            out.append(b)\n    try:\n        b = os.path.dirname(os.path.abspath(__file__))\n        if b not in out:\n            out.append(b)\n    except Exception:\n        pass\n    return out\n\n\ndef cari_folder(metode, destinasi, base_dir=\".\"):\n    nama_metode = [_nn(x) for x in METHOD_ALIASES.get(metode, [METHOD_FOLDERS.get(metode, \"\")])]\n    aliases = {_nn(a) for a in DEST_ALIASES.get(destinasi.lower(), [])} | {_nn(destinasi)}\n    aliases.discard(\"\")\n\n    for base in _kandidat_base(base_dir):\n        # 1) folder metode (nama toleran)\n        m_dirs = [d for d in _subdirs(base) if _nn(d) in nama_metode]\n        for md in m_dirs:\n            full_m = os.path.join(base, md)\n            subs = _subdirs(full_m)\n            # exact (ternormalisasi) lebih dulu, lalu \"mengandung\"\n            urut = [s for s in subs if _nn(s) in aliases] + \\\n                   [s for s in subs if _nn(s) not in aliases\n                    and any(a in _nn(s) or _nn(s) in a for a in aliases if len(_nn(s)) >= 4)]\n            for s in urut:\n                akar = _akar_hasil(os.path.join(full_m, s))\n                if akar:\n                    return akar\n    return None\n\n\ndef _daftar_dicari(metode, base_dir=\".\"):\n    return [os.path.join(b, METHOD_FOLDERS.get(metode, \"?\")) for b in _kandidat_base(base_dir)]\n\n\n# ============================================================\n# PEMUATAN HASIL DARI FOLDER NOTEBOOK\n# ============================================================\n# ============================================================\n# PRA-PROSES ICEEMDAN-VMD-GRU (SAMA DENGAN NOTEBOOK)\n# ============================================================\nICE_TRIALS, ICE_EPSILON, ICE_SEED, ICE_MAX_IMF = 100, 0.2, 42, 15\nVMD_TAU, VMD_DC, VMD_INIT, VMD_TOL = 0.0, 0, 1, 1e-7\nVMD_K_RANGE = range(2, 13)                 # K = 2..12\nVMD_ALPHA_RANGE = range(100, 2100, 100)    # alpha = 100..2000\nVMD_CORR_THRESHOLD = 1.2\n\nBULAN_MAP = {\"Januari\": 1, \"Februari\": 2, \"Maret\": 3, \"April\": 4, \"Mei\": 5, \"Juni\": 6,\n             \"Juli\": 7, \"Agustus\": 8, \"September\": 9, \"Oktober\": 10,\n             \"November\": 11, \"Desember\": 12}\n\n\ndef _cache(fn):\n    if st is not None and hasattr(st, \"cache_data\"):\n        return st.cache_data(show_spinner=False)(fn)\n    return fn\n\n\n# ---------- 1. Baca file unggahan + deteksi nilai 0 ----------\ndef baca_file_unggahan(file):\n    \"\"\"Baca Excel format notebook (Bulan, Tahun, Pengunjung) atau (date, visitors).\n    Mengembalikan DataFrame [date, visitors] apa adanya (nilai 0 belum ditangani).\"\"\"\n    df = pd.read_excel(file)\n    cols = {str(c).strip().lower(): c for c in df.columns}\n    vcol = cols.get(\"pengunjung\") or cols.get(\"visitors\")\n    if vcol is None:\n        raise ValueError(\"Kolom 'Pengunjung' (atau 'visitors') tidak ditemukan di file.\")\n\n    if \"date\" in cols:\n        dates = pd.to_datetime(df[cols[\"date\"]])\n    elif \"bulan\" in cols and \"tahun\" in cols:\n        tahun = pd.to_numeric(df[cols[\"tahun\"]], errors=\"coerce\").ffill().astype(int)\n        bulan = df[cols[\"bulan\"]].astype(str).str.strip().str.title().map(BULAN_MAP)\n        if bulan.isna().any():\n            bad = df.loc[bulan.isna(), cols[\"bulan\"]].unique().tolist()\n            raise ValueError(f\"Nama bulan tidak dikenali: {bad}\")\n        dates = pd.to_datetime(dict(year=tahun, month=bulan, day=1))\n    else:\n        raise ValueError(\"Butuh kolom 'date' atau kolom 'Bulan' + 'Tahun'.\")\n\n    out = pd.DataFrame({\"date\": dates,\n                        \"visitors\": pd.to_numeric(df[vcol], errors=\"coerce\").fillna(0.0)})\n    return out.sort_values(\"date\").reset_index(drop=True)\n\n\ndef deteksi_nol(df):\n    \"\"\"Daftar baris bernilai 0 (kolom: date, visitors).\"\"\"\n    return df[df[\"visitors\"] == 0][[\"date\", \"visitors\"]].reset_index(drop=True)\n\n\ndef proses_interpolasi(df):\n    \"\"\"0 -> NaN -> interpolasi linear (identik notebook).\"\"\"\n    raw = df[\"visitors\"].astype(float)\n    clean = raw.mask(raw == 0).interpolate(method=\"linear\", limit_direction=\"both\")\n    return {\n        \"dates\": pd.to_datetime(df[\"date\"]).reset_index(drop=True),\n        \"raw\": raw.values,\n        \"clean\": clean.values,\n        \"idx_nol\": np.where(raw.values == 0)[0],\n    }\n\n\ndef panel_unggah_admin(key=\"adm_upload\"):\n    \"\"\"Pakai di halaman Admin. Return (raw_df, data_clean) atau (None, None).\n    data_clean (sudah diinterpolasi) bisa langsung dipakai untuk jalankan_metode().\"\"\"\n    f = st.file_uploader(\"Unggah file Excel data kunjungan\", type=[\"xlsx\", \"xls\"], key=key)\n    if f is None:\n        return None, None\n    try:\n        raw_df = baca_file_unggahan(f)\n    except Exception as e:\n        st.error(f\"File tidak dapat dibaca: {e}\")\n        return None, None\n    nol = deteksi_nol(raw_df)\n    if len(nol):\n        st.warning(f\"Terdeteksi {len(nol)} nilai 0 pada data. \"\n                   \"Akan ditangani dengan interpolasi linear.\")\n    else:\n        st.success(\"Tidak ada nilai 0 pada data.\")\n    pra = proses_interpolasi(raw_df)\n    data_clean = pd.DataFrame({\"date\": pra[\"dates\"], \"visitors\": pra[\"clean\"]})\n    return raw_df, data_clean\n\n\n# ---------- 2. ICEEMDAN (kode notebook) ----------\ndef _n_extrema(x):\n    d = np.diff(x)\n    return int(np.sum(d[:-1] * d[1:] < 0))\n\n\ndef _local_mean(z):\n    imfs = EMD().emd(z, max_imf=1)\n    if len(imfs) < 2:\n        return z.copy()\n    return z - imfs[0]\n\n\ndef _noise_imfs(n, seed, kmax):\n    w = np.random.default_rng(seed).standard_normal(n)\n    imfs = EMD().emd(w)\n    out = np.zeros((kmax, n))\n    for k in range(min(kmax, len(imfs))):\n        s = imfs[k].std()\n        if s > 0:\n            out[k] = imfs[k] / s\n    return out\n\n\ndef _trial_mean(r, noise_k, beta):\n    return _local_mean(r + beta * noise_k)\n\n\ndef _iceemdan_nb(x, trials, epsilon0, max_imf, seed, n_jobs=-1):\n    x = np.asarray(x, dtype=float)\n    n = len(x)\n    ss = np.random.SeedSequence(seed).spawn(trials)\n    seeds = [int(s.generate_state(1)[0]) for s in ss]\n    noise = Parallel(n_jobs=n_jobs)(delayed(_noise_imfs)(n, sd, max_imf + 1) for sd in seeds)\n    modes, r_prev = [], x.copy()\n    for k in range(1, max_imf + 1):\n        beta = epsilon0 * np.std(r_prev)\n        means = Parallel(n_jobs=n_jobs)(\n            delayed(_trial_mean)(r_prev, noise[i][k - 1], beta) for i in range(trials))\n        r_k = np.mean(means, axis=0)\n        modes.append(r_prev - r_k)\n        r_prev = r_k\n        if _n_extrema(r_prev) < 3:\n            break\n    modes.append(r_prev)\n    return np.array(modes)\n\n\n@_cache\ndef hitung_iceemdan(x):\n    \"\"\"Return dict {IMF_1..IMF_n, ICEEMDAN_Residue}. Di-cache agar tidak dihitung ulang.\"\"\"\n    if EMD is None:\n        raise RuntimeError(\"Paket EMD-signal belum terpasang (pip install EMD-signal).\")\n    modes = _iceemdan_nb(np.asarray(x, float), ICE_TRIALS, ICE_EPSILON, ICE_MAX_IMF, ICE_SEED)\n    comps = {f\"IMF_{i + 1}\": modes[i] for i in range(len(modes) - 1)}\n    comps[\"ICEEMDAN_Residue\"] = modes[-1]\n    return comps\n\n\n# ---------- 3. VMD (kode notebook) ----------\ndef _vmd_metrics(f, u):\n    K = u.shape[0]\n    cors = [abs(pearsonr(u[i], u[i + 1])[0]) for i in range(K - 1)]\n    mean_corr = float(np.mean(cors)) if cors else 0.0\n    elc = float(np.sum((f - np.sum(u, axis=0)) ** 2) / np.sum(f ** 2))\n    bws = []\n    for i in range(K):\n        psd = np.abs(np.fft.fft(u[i])) ** 2\n        fr = np.fft.fftfreq(len(u[i]))\n        pos = fr >= 0\n        p, fp = psd[pos], fr[pos]\n        if p.sum() > 0:\n            mf = np.sum(fp * p) / p.sum()\n            bws.append(np.sum(((fp - mf) ** 2) * p) / p.sum())\n        else:\n            bws.append(0.0)\n    return mean_corr, elc, float(np.mean(bws))\n\n\n@_cache\ndef cari_vmd(f):\n    \"\"\"Pencarian K & alpha untuk SATU sinyal IMF persis seperti notebook.\n    Return {'candidates': [...], 'best': {...}, 'modes': ndarray(K, N)}.\"\"\"\n    if VMD is None:\n        raise RuntimeError(\"Paket vmdpy belum terpasang (pip install vmdpy).\")\n    f = np.asarray(f, dtype=float)\n    candidates = []\n    for K in VMD_K_RANGE:\n        prev_corr, best_a, best_m = 999, None, None\n        for alpha in VMD_ALPHA_RANGE:\n            u, _, _ = VMD(f, alpha, VMD_TAU, K, VMD_DC, VMD_INIT, VMD_TOL)\n            corr, elc, bw = _vmd_metrics(f, u)\n            if alpha > 100 and corr > prev_corr * VMD_CORR_THRESHOLD:\n                break\n            best_a, best_m, prev_corr = alpha, (corr, elc, bw), corr\n        if best_a is not None:\n            candidates.append({\"K\": K, \"alpha\": best_a, \"Corr\": best_m[0],\n                               \"ELC\": best_m[1], \"BW\": best_m[2]})\n    filt = [c for c in candidates if c[\"ELC\"] < 0.01] or candidates\n    best = min(filt, key=lambda c: (round(c[\"BW\"], 5), c[\"ELC\"], c[\"Corr\"]))\n    u_opt, _, _ = VMD(f, best[\"alpha\"], VMD_TAU, best[\"K\"], VMD_DC, VMD_INIT, VMD_TOL)\n    return {\"candidates\": candidates, \"best\": best, \"modes\": np.asarray(u_opt)}\n\n\ndef hitung_semua_vmd(imfs, progress=None):\n    \"\"\"Jalankan VMD untuk semua IMF (residu ICEEMDAN tidak di-VMD, sama dgn notebook).\"\"\"\n    names = [k for k in imfs if \"RESIDUE\" not in k.upper()]\n    out = {}\n    for i, name in enumerate(names):\n        if progress:\n            progress(i / max(len(names), 1), f\"Mencari parameter VMD untuk {name} \"\n                                             f\"({i + 1}/{len(names)})...\")\n        out[name] = cari_vmd(np.asarray(imfs[name], float))\n    if progress:\n        progress(1.0, \"Selesai\")\n    return out\n\n\ndef gabung_komponen(imfs, vmd_all):\n    \"\"\"Susun komponen final: IMF_k_VMD_m ... + ICEEMDAN_Residue (urutan = notebook).\"\"\"\n    comps = {}\n    for name, r in vmd_all.items():\n        for m in range(r[\"modes\"].shape[0]):\n            comps[f\"{name}_VMD_{m + 1}\"] = r[\"modes\"][m]\n    for k in imfs:\n        if \"RESIDUE\" in k.upper():\n            comps[k] = np.asarray(imfs[k], float)\n    return comps\n\n\n# ---------- 4. Grafik ----------\n_PAL = [\"#1e293b\", \"#0284c7\", \"#0d9488\", \"#16a34a\", \"#ca8a04\", \"#ea580c\", \"#dc2626\", \"#9333ea\"]\n\n\ndef _stack_fig(dates, items, h_per=150):\n    \"\"\"items = [(judul, y), ...] -> subplot bertumpuk.\"\"\"\n    n = len(items)\n    fig = make_subplots(rows=n, cols=1, shared_xaxes=True,\n                        vertical_spacing=min(0.035, 0.9 / max(n, 1)),\n                        subplot_titles=[t.replace(\"_\", \" \") for t, _ in items])\n    for i, (t, y) in enumerate(items):\n        fig.add_trace(go.Scatter(\n            x=dates, y=y, mode=\"lines\", showlegend=False,\n            line=dict(color=_PAL[i % len(_PAL)], width=1.6),\n            hovertemplate=f\"{t}: %{{y:,.2f}}<extra></extra>\"), row=i + 1, col=1)\n    fig.update_layout(height=max(h_per * n, 320), plot_bgcolor=\"#ffffff\", paper_bgcolor=\"#ffffff\",\n                      margin=dict(l=10, r=10, t=30, b=10),\n                      font=dict(family=\"Plus Jakarta Sans, sans-serif\", size=11, color=\"#334155\"))\n    return fig\n\n\ndef fig_deteksi_nol(pra):\n    \"\"\"Data aktual (sebelum interpolasi); nilai 0 ditandai merah.\"\"\"\n    fig = go.Figure()\n    fig.add_trace(go.Scatter(x=pra[\"dates\"], y=pra[\"raw\"], mode=\"lines+markers\",\n                             name=\"Data Aktual\", line=dict(color=\"#1e293b\", width=1.8),\n                             marker=dict(size=4),\n                             hovertemplate=\"Aktual: %{y:,.0f}<extra></extra>\"))\n    i0 = pra[\"idx_nol\"]\n    if len(i0):\n        fig.add_trace(go.Scatter(x=pra[\"dates\"].iloc[i0], y=pra[\"raw\"][i0], mode=\"markers\",\n                                 name=\"Nilai 0 Terdeteksi\",\n                                 marker=dict(size=10, color=\"#ef4444\", symbol=\"diamond\"),\n                                 hovertemplate=\"Nilai 0<extra></extra>\"))\n    return _base_layout(fig, h=340)\n\n\ndef fig_interpolasi_x(pra):\n    \"\"\"Hasil interpolasi linear; titik 0 yang berhasil diinterpolasi diberi tanda x.\"\"\"\n    fig = go.Figure()\n    fig.add_trace(go.Scatter(x=pra[\"dates\"], y=pra[\"clean\"], mode=\"lines\", name=\"Hasil Interpolasi Linear\",\n                             line=dict(color=\"#0284c7\", width=2.4),\n                             hovertemplate=\"Interpolasi: %{y:,.0f}<extra></extra>\"))\n    i0 = pra[\"idx_nol\"]\n    if len(i0):\n        fig.add_trace(go.Scatter(x=pra[\"dates\"].iloc[i0], y=pra[\"clean\"][i0], mode=\"markers\",\n                                 name=\"Nilai 0 → Terinterpolasi (x)\",\n                                 marker=dict(size=11, color=\"#ef4444\", symbol=\"x\",\n                                             line=dict(width=2, color=\"#ef4444\")),\n                                 hovertemplate=\"Hasil imputasi: %{y:,.0f}<extra></extra>\"))\n    return _base_layout(fig, h=340)\n\n\ndef fig_vmd_search(cands, best):\n    \"\"\"3 panel: Mean Bandwidth, ELC, Mean Correlation terhadap K (K optimal garis merah).\"\"\"\n    df = pd.DataFrame(cands)\n    fig = make_subplots(rows=1, cols=3, horizontal_spacing=0.07,\n                        subplot_titles=[\"Mean Bandwidth\", \"Energy Loss (ELC)\", \"Mean Correlation\"])\n    for i, (col, sym) in enumerate([(\"BW\", \"circle\"), (\"ELC\", \"square\"), (\"Corr\", \"diamond\")], 1):\n        fig.add_trace(go.Scatter(\n            x=df[\"K\"], y=df[col], mode=\"lines+markers\", showlegend=False,\n            line=dict(color=\"#0284c7\"), marker=dict(symbol=sym, size=7), customdata=df[\"alpha\"],\n            hovertemplate=\"K=%{x}<br>alpha=%{customdata}<br>\" + col + \"=%{y:.5f}<extra></extra>\"),\n            row=1, col=i)\n        fig.add_trace(go.Scatter(x=[best[\"K\"]], y=[best[col]], mode=\"markers\", showlegend=False,\n                                 marker=dict(color=\"#ef4444\", size=12), hoverinfo=\"skip\"),\n                      row=1, col=i)\n        fig.add_vline(x=best[\"K\"], line=dict(color=\"#ef4444\", dash=\"dash\"), row=1, col=i)\n    fig.add_hline(y=0.01, line=dict(color=\"#f59e0b\", dash=\"dash\"), row=1, col=2)\n    fig.update_xaxes(dtick=1, title_text=\"K\")\n    fig.update_layout(height=340, plot_bgcolor=\"#ffffff\", paper_bgcolor=\"#ffffff\",\n                      margin=dict(l=10, r=10, t=40, b=10),\n                      font=dict(family=\"Plus Jakarta Sans, sans-serif\", size=11, color=\"#334155\"))\n    return fig\n\n\ndef fig_norm_pra(dates, y_raw, y_norm, nama):\n    fig = make_subplots(rows=1, cols=2, horizontal_spacing=0.08,\n                        subplot_titles=[f\"Sebelum Normalisasi — {nama}\",\n                                        f\"Sesudah Normalisasi (0–1) — {nama}\"])\n    fig.add_trace(go.Scatter(x=dates, y=y_raw, mode=\"lines\", name=\"Skala Asli\",\n                             line=dict(color=\"#0284c7\", width=2.0),\n                             hovertemplate=\"Nilai asli: %{y:,.2f}<extra></extra>\"), row=1, col=1)\n    fig.add_trace(go.Scatter(x=dates, y=y_norm, mode=\"lines\", name=\"Skala [0, 1]\",\n                             line=dict(color=\"#10b981\", width=2.0),\n                             hovertemplate=\"Normalisasi: %{y:.4f}<extra></extra>\"), row=1, col=2)\n    fig.update_yaxes(title_text=\"Nilai Asli\", row=1, col=1)\n    fig.update_yaxes(title_text=\"Value (0–1)\", range=[-0.05, 1.05], row=1, col=2)\n    fig.update_layout(height=380, plot_bgcolor=\"#ffffff\", paper_bgcolor=\"#ffffff\",\n                      margin=dict(l=10, r=10, t=40, b=10), showlegend=False,\n                      font=dict(family=\"Plus Jakarta Sans, sans-serif\", size=11, color=\"#334155\"))\n    return fig\n\n\n# ---------- 5. Penyedia data pra-proses ----------\ndef _raw_df_dari_h(h):\n    \"\"\"Bila tidak ada file unggahan, rekonstruksi data mentah dari hasil folder (gap = 0).\"\"\"\n    return pd.DataFrame({\"date\": pd.to_datetime(h[\"tgl_hist\"]),\n                         \"visitors\": h.get(\"raw_hist\", h[\"aktual_hist\"])})\n\n\ndef _ambil_imfs(h, pra, dari_unggahan):\n    \"\"\"ICEEMDAN: dari folder notebook bila ada & tidak ada unggahan baru; selain itu hitung.\"\"\"\n    ice = h.get(\"ice_data\") or {}\n    if (not dari_unggahan) and h.get(\"loaded_from_folder\") and ice:\n        return {k: np.asarray(v, float) for k, v in ice.items()}\n    with st.spinner(\"Menjalankan I-CEEMDAN (trials=100, ε0=0.2, seed=42)... \"\n                    \"pertama kali bisa beberapa menit, selanjutnya instan.\"):\n        return hitung_iceemdan(np.asarray(pra[\"clean\"], float))\n\n\ndef _progress_ui():\n    bar = st.progress(0.0, text=\"Memulai...\")\n    def cb(f, t):\n        bar.progress(min(max(f, 0.0), 1.0), text=t)\n    return bar, cb\n\n\n# ---------- 6. Render tahap Interpolasi / ICEEMDAN / VMD / Normalisasi ----------\ndef render_tahap_praproses(h, tahap, kp, raw_df=None):\n    if go is None or make_subplots is None:\n        st.error(\"Plotly belum terpasang.\")\n        return\n    df = raw_df if raw_df is not None else _raw_df_dari_h(h)\n    pra = proses_interpolasi(df)\n    tgl = pra[\"dates\"]\n\n    # ICEEMDAN/VMD hanya dihitung ulang jika data hasil interpolasi BERBEDA dari\n    # data di folder notebook. Jika sama, hasil folder dipakai (instan).\n    dari_unggahan = False\n    if raw_df is not None:\n        a = np.asarray(h[\"aktual_hist\"], float)\n        b = np.asarray(pra[\"clean\"], float)\n        dari_unggahan = (len(a) != len(b)) or float(np.max(np.abs(a - b))) > 2.0\n\n    # ============ INTERPOLASI LINEAR ============\n    if tahap == \"Interpolasi Linear\":\n        n0 = len(pra[\"idx_nol\"])\n        c1, c2, c3 = st.columns(3, gap=\"medium\")\n        with c1:\n            _mcard(\"a\", \"TOTAL DATA\", _fmt_id(len(df)), \"observasi bulanan\")\n        with c2:\n            _mcard(\"b\", \"NILAI 0 TERDETEKSI\", _fmt_id(n0),\n                   f\"{n0 / max(len(df), 1) * 100:.1f}% dari data\")\n        with c3:\n            _mcard(\"a\", \"METODE PENANGANAN\", \"Linear\", \"0 → NaN → interpolasi linear\")\n        st.write(\"\")\n        with st.container(border=True):\n            _head(\"Data Aktual (Sebelum Interpolasi)\",\n                  \"Titik merah = nilai 0 yang terdeteksi pada file masukan\")\n            _show_chart(fig_deteksi_nol(pra), key=f\"{kp}_deteksi\")\n        st.write(\"\")\n        with st.container(border=True):\n            _head(\"Hasil Interpolasi Linear\",\n                  \"Tanda x = nilai 0 yang berhasil diinterpolasi\")\n            _show_chart(fig_interpolasi_x(pra), key=f\"{kp}_interp\")\n            if n0:\n                with st.expander(\"Lihat tabel nilai 0 yang diimputasi\"):\n                    i0 = pra[\"idx_nol\"]\n                    _show_df(pd.DataFrame({\n                        \"Bulan\": [_tgl_id(d) for d in tgl.iloc[i0]],\n                        \"Nilai Awal\": [0] * n0,\n                        \"Hasil Interpolasi\": [_fmt_id(v) for v in pra[\"clean\"][i0]],\n                    }), hide_index=True)\n            else:\n                st.info(\"Tidak ada nilai 0, data digunakan apa adanya.\")\n        return\n\n    # ============ ICEEMDAN ============\n    imfs = _ambil_imfs(h, pra, dari_unggahan)\n    keys = list(imfs.keys())\n    n_imf = len(keys) - 1\n\n    if tahap == \"Dekomposisi I-CEEMDAN\":\n        with st.container(border=True):\n            _head(\"Dekomposisi I-CEEMDAN\")\n            items = [(\"Sinyal Input (Hasil Interpolasi)\", pra[\"clean\"])]\n            items += [(k, imfs[k]) for k in keys]\n            _show_chart(_stack_fig(tgl, items), key=f\"{kp}_ice\")\n            rec = np.sum([imfs[k] for k in keys], axis=0)\n            st.caption(f\"MAE rekonstruksi (Σ IMF + residu vs sinyal): \"\n                       f\"{_fmt_id(np.mean(np.abs(pra['clean'] - rec)), 6)}\")\n        return\n\n    # ============ VMD ============\n    if tahap == \"Dekomposisi VMD\":\n        bar, cb = _progress_ui()\n        try:\n            vmd_all = hitung_semua_vmd(imfs, cb)\n        except Exception as e:\n            bar.empty()\n            st.error(f\"VMD gagal dijalankan: {e}\")\n            return\n        bar.empty()\n\n        with st.container(border=True):\n            _head(\"Parameter VMD Terbaik per IMF\")\n            _show_df(pd.DataFrame([{\n                \"IMF\": n, \"K\": r[\"best\"][\"K\"], \"Alpha\": r[\"best\"][\"alpha\"],\n                \"Corr\": round(r[\"best\"][\"Corr\"], 5), \"ELC\": round(r[\"best\"][\"ELC\"], 5),\n                \"BW\": round(r[\"best\"][\"BW\"], 5)} for n, r in vmd_all.items()]),\n                hide_index=True)\n        st.write(\"\")\n        for i, (name, r) in enumerate(vmd_all.items()):\n            b = r[\"best\"]\n            with st.expander(f\"{name} — optimal K={b['K']}, Alpha={b['alpha']}\", expanded=(i == 0)):\n                _head(f\"Pencarian Parameter VMD ({name})\",\n                      f\"Garis merah = K optimal (K={b['K']}, Alpha={b['alpha']})\")\n                _show_chart(fig_vmd_search(r[\"candidates\"], b), key=f\"{kp}_vs_{name}\")\n                _head(f\"Hasil Dekomposisi VMD ({name})\", f\"{b['K']} mode\")\n                items = [(f\"Sinyal Input ({name})\", imfs[name])]\n                items += [(f\"Mode {m + 1}\", r[\"modes\"][m]) for m in range(r[\"modes\"].shape[0])]\n                _show_chart(_stack_fig(tgl, items, h_per=130), key=f\"{kp}_vm_{name}\")\n        return\n\n    # ============ NORMALISASI ============\n    if tahap == \"Normalisasi\":\n        if (not dari_unggahan) and h.get(\"loaded_from_folder\") and h.get(\"comps\"):\n            comps = {k: np.asarray(v, float) for k, v in h[\"comps\"].items()}\n        else:\n            bar, cb = _progress_ui()\n            vmd_all = hitung_semua_vmd(imfs, cb)\n            bar.empty()\n            comps = gabung_komponen(imfs, vmd_all)\n\n        nama = st.selectbox(\"Pilih komponen\", list(comps.keys()), key=f\"{kp}_pilih_norm\")\n        y = comps[nama].reshape(-1, 1)\n        sc = MinMaxScaler(feature_range=(0, 1))\n        y_norm = sc.fit_transform(y).ravel()\n        with st.container(border=True):\n            _head(\"Normalisasi Min-Max per Komponen\")\n            _show_chart(fig_norm_pra(tgl, y.ravel(), y_norm, nama), key=f\"{kp}_norm\")\n            with st.expander(\"Ringkasan Min–Max seluruh komponen\"):\n                _show_df(pd.DataFrame([{\n                    \"Komponen\": k, \"x_min\": round(float(np.min(v)), 4),\n                    \"x_max\": round(float(np.max(v)), 4),\n                    \"Range\": round(float(np.max(v) - np.min(v)), 4)}\n                    for k, v in comps.items()]), hide_index=True)\n\n\n# ============================================================\n# PEMUATAN HASIL DARI FOLDER NOTEBOOK  (direkonstruksi: bagian ini hilang di versi lama)\n# ============================================================\ndef _rmse(y, p):\n    y, p = np.asarray(y, float), np.asarray(p, float)\n    return float(np.sqrt(np.mean((y - p) ** 2)))\n\n\ndef _mape(y, p, eps=1e-8):\n    y, p = np.asarray(y, float), np.asarray(p, float)\n    return float(np.mean(np.abs((y - p) / np.maximum(np.abs(y), eps))) * 100.0)\n\n\ndef _cari_scaler(scaler_dir, comp_name, metode=None):\n    \"\"\"Cari file scaler (.pkl/.joblib) untuk satu komponen; toleran nama.\"\"\"\n    if not os.path.isdir(scaler_dir):\n        return None\n    files = [f for f in os.listdir(scaler_dir) if f.lower().endswith((\".pkl\", \".joblib\"))]\n    for cand in (f\"scaler_{comp_name}.pkl\", f\"{comp_name}.pkl\", f\"scaler_{comp_name}.joblib\"):\n        if cand in files:\n            return os.path.join(scaler_dir, cand)\n    target = _nn(comp_name)\n    for f in files:\n        stem = _nn(os.path.splitext(f)[0])\n        if stem in (target, \"scaler\" + target, target + \"scaler\"):\n            return os.path.join(scaler_dir, f)\n    if metode == \"GRU\" and len(files) == 1:       # GRU murni: hanya ada satu scaler\n        return os.path.join(scaler_dir, files[0])\n    return None\n\n\ndef _scaler_inverse(pkl, arr):\n    \"\"\"inverse_transform dengan scaler tersimpan; None bila gagal (dipakai fallback min-max).\"\"\"\n    try:\n        import joblib\n        sc = joblib.load(pkl)\n        return sc.inverse_transform(np.asarray(arr, float).reshape(-1, 1)).ravel()\n    except Exception:\n        return None\n\n\ndef _norm_minmax(comps):\n    out = {}\n    for k, v in comps.items():\n        v = np.asarray(v, float)\n        rng = v.max() - v.min()\n        out[k] = ((v - v.min()) / (rng if rng > 0 else 1.0)).tolist()\n    return out\n\n\ndef _ringkas_minmax(comps):\n    rows = []\n    for k, v in comps.items():\n        v = np.asarray(v, float)\n        rows.append({\"Komponen\": k, \"x_min\": float(v.min()), \"x_max\": float(v.max()),\n                     \"range\": float(v.max() - v.min())})\n    return rows\n\n\ndef _turunan_dari_comps(comps, metode):\n    \"\"\"Turunkan (ice_data, vmd_modes) dari komponen akhir (dipakai hasil fallback).\"\"\"\n    comps = {k: np.asarray(v, float) for k, v in comps.items()}\n    if metode == \"Hybrid ICEEMDAN-GRU\":\n        return {k: v.tolist() for k, v in comps.items()}, {}\n    if metode == \"Hybrid VMD-GRU\":\n        return {}, {k: v.tolist() for k, v in comps.items()}\n    if metode == \"Hybrid ICEEMDAN-VMD-GRU\":\n        ice, vmd, grup = {}, {}, {}\n        for k, v in comps.items():\n            m = re.match(r\"^(IMF_\\d+)_VMD_\\d+$\", k)\n            if m:\n                grup.setdefault(m.group(1), []).append(v)\n                vmd[k] = v.tolist()\n            elif \"RESIDUE\" in k.upper():\n                ice[k] = v.tolist()\n        for imf, lst in grup.items():\n            ice[imf] = np.sum(lst, axis=0).tolist()\n        return dict(sorted(ice.items(), key=lambda kv: ((\"RESIDUE\" in kv[0].upper()), kv[0]))), vmd\n    return {}, {}\n\n\ndef _baca_tabel(path):\n    try:\n        if path.lower().endswith((\".xlsx\", \".xls\")):\n            return pd.read_excel(path)\n        return pd.read_csv(path)\n    except Exception:\n        return None\n\n\ndef _kolom_tanggal(df):\n    low = {str(c).strip().lower(): c for c in df.columns}\n    for k in (\"date\", \"tanggal\", \"periode\"):\n        if k in low:\n            return pd.to_datetime(df[low[k]]).dt.to_period(\"M\").dt.to_timestamp()\n    if \"bulan\" in low and \"tahun\" in low:\n        tahun = pd.to_numeric(df[low[\"tahun\"]], errors=\"coerce\").ffill().astype(int)\n        bln = df[low[\"bulan\"]].map(fe._bulan_ke_angka)      # Indonesia/Inggris/angka\n        if bln.isna().any():\n            raise _Gagal(\"Nama bulan pada data_cleaned_after_imputation.xlsx tidak dikenali\")\n        return pd.to_datetime(dict(year=tahun, month=bln.astype(int), day=1))\n    raise _Gagal(\"Kolom tanggal (date / Bulan+Tahun) tidak ditemukan di data_cleaned_after_imputation.xlsx\")\n\n\ndef _muat_interpolasi(folder):\n    \"\"\"Return (dates[str], visitors_clean[float], raw_visitors[float], gap_log[list]).\"\"\"\n    p = os.path.join(folder, \"hasil-interpolasi\", \"data_cleaned_after_imputation.xlsx\")\n    if not os.path.exists(p):\n        raise _Gagal(f\"File tidak ada: {p}\")\n    df = _baca_tabel(p)\n    if df is None or df.empty:\n        raise _Gagal(f\"File tidak terbaca/kosong: {p}\")\n    tgl = _kolom_tanggal(df)\n    cols = {str(c).strip().lower(): c for c in df.columns}\n\n    def pilih(*kunci):\n        for k in kunci:\n            for lc, c in cols.items():\n                if k == lc:\n                    return c\n        for k in kunci:\n            for lc, c in cols.items():\n                if k in lc:\n                    return c\n        return None\n\n    c_raw = pilih(\"raw\", \"original\", \"asli\", \"sebelum\", \"visitors_raw\")\n    c_clean = pilih(\"cleaned\", \"clean\", \"imput\", \"interpol\", \"visitors\", \"pengunjung\")\n    if c_clean is None or c_clean == c_raw:\n        num = [c for c in df.columns if pd.api.types.is_numeric_dtype(df[c])\n               and str(c).strip().lower() not in (\"tahun\", \"year\", \"bulan\", \"month\")]\n        if not num:\n            raise _Gagal(f\"Kolom jumlah pengunjung tidak ditemukan di {p}\")\n        c_clean = num[-1]\n    clean = pd.to_numeric(df[c_clean], errors=\"coerce\").astype(float).values\n    raw = (pd.to_numeric(df[c_raw], errors=\"coerce\").fillna(0.0).astype(float).values\n           if c_raw is not None and c_raw != c_clean else clean.copy())\n    dates = [d.strftime(\"%Y-%m-%d\") for d in tgl]\n    gap_log = [{\"date\": dates[i], \"new_value\": float(clean[i])}\n               for i in np.where(raw == 0)[0] if clean[i] != 0]\n    return dates, clean.tolist(), raw.tolist(), gap_log\n\n\ndef _muat_dekomposisi(folder, nama_komp):\n    \"\"\"Ambil komponen (IMF/VMD) dari hasil-dekomposisi; return (comps, ice_data).\"\"\"\n    comps, ice = {}, {}\n    dd = os.path.join(folder, \"hasil-dekomposisi\")\n    files = []\n    for ext in (\"*.csv\", \"*.xlsx\"):\n        files += glob.glob(os.path.join(dd, ext))\n    peta = {_nn(n): n for n in nama_komp}\n    for f in sorted(files):\n        df = _baca_tabel(f)\n        if df is None:\n            continue\n        is_ice = \"iceemdan\" in os.path.basename(f).lower() and \"vmd\" not in os.path.basename(f).lower()\n        for c in df.columns:\n            key = _nn(c)\n            if key in (\"sinyalasli\", \"date\", \"tanggal\", \"bulan\", \"tahun\", \"unnamed0\"):\n                continue\n            if not pd.api.types.is_numeric_dtype(df[c]):\n                continue\n            if is_ice and (re.match(r\"^IMF_\\d+$\", str(c)) or \"residue\" in str(c).lower()):\n                ice[str(c)] = pd.to_numeric(df[c], errors=\"coerce\").fillna(0).astype(float).tolist()\n            if key in peta and peta[key] not in comps:\n                comps[peta[key]] = pd.to_numeric(df[c], errors=\"coerce\").fillna(0).astype(float).tolist()\n    return comps, ice\n\n\ndef _muat_inti(folder, destinasi, metode):\n    \"\"\"Muat seluruh hasil notebook dari satu folder. Raise _Gagal bila tidak lengkap.\"\"\"\n    dates, visitors_clean, raw_visitors, gap_log = _muat_interpolasi(folder)\n\n    # ---- Prediksi uji per komponen + denormalisasi (scaler PKL) ----\n    preds_dir = os.path.join(folder, \"retrain-preds\")\n    scaler_dir = os.path.join(folder, \"scaler\")\n    pred_files = sorted(glob.glob(os.path.join(preds_dir, \"preds_*.csv\"))) if os.path.isdir(preds_dir) else []\n    if not pred_files:\n        raise _Gagal(f\"Tidak ada preds_*.csv di {preds_dir}\")\n\n    comps0, _ice0 = _muat_dekomposisi(folder, [os.path.splitext(os.path.basename(p))[0].replace(\"preds_\", \"\", 1)\n                                               for p in pred_files])\n    min_max_summary = _ringkas_minmax(comps0) if comps0 else []\n    v_min, v_max = min(visitors_clean), max(visitors_clean)\n    sub_mode_preds, y_preds_den_list = {}, []\n    for pf in pred_files:\n        comp_name = os.path.splitext(os.path.basename(pf))[0].replace(\"preds_\", \"\", 1)\n        try:\n            dfp = pd.read_csv(pf)\n            y_true_n = dfp[\"y_true\"].values.astype(float)\n            y_pred_n = dfp[\"y_pred\"].values.astype(float)\n        except Exception as e:\n            raise _Gagal(f\"File prediksi tidak terbaca ({pf}): {e}\")\n\n        y_pred_den = y_true_den = None\n        pkl = _cari_scaler(scaler_dir, comp_name, metode)\n        if pkl:\n            y_pred_den = _scaler_inverse(pkl, y_pred_n)\n            y_true_den = _scaler_inverse(pkl, y_true_n)\n        if y_pred_den is None or y_true_den is None:\n            mm = next((m for m in min_max_summary if m[\"Komponen\"] == comp_name), None)\n            if mm and mm[\"range\"] > 0:\n                x_min, rng = mm[\"x_min\"], mm[\"range\"]\n            elif metode == \"GRU\":             # GRU murni: skala = data asli\n                x_min, rng = v_min, max(v_max - v_min, 1e-8)\n            else:\n                raise _Gagal(f\"Scaler untuk komponen '{comp_name}' tidak ada/rusak di {scaler_dir} \"\n                             f\"(butuh scaler_{comp_name}.pkl) sehingga denormalisasi tidak akurat\")\n            y_pred_den = y_pred_n * rng + x_min\n            y_true_den = y_true_n * rng + x_min\n\n        sub_mode_preds[comp_name] = {\n            \"y_true_norm\": y_true_n.tolist(), \"y_pred_norm\": y_pred_n.tolist(),\n            \"y_pred_den\": np.asarray(y_pred_den).tolist(),\n            \"y_true_den\": np.asarray(y_true_den).tolist(),\n            \"mae_norm\": float(np.mean(np.abs(y_true_n - y_pred_n))),\n            \"rmse_norm\": _rmse(y_true_n, y_pred_n),\n            \"mape_norm\": _mape(y_true_n, y_pred_n),\n            \"mae_den\": float(np.mean(np.abs(y_true_den - y_pred_den))),\n            \"rmse_den\": _rmse(y_true_den, y_pred_den),\n            \"mape_den\": _mape(y_true_den, y_pred_den),\n        }\n        y_preds_den_list.append(np.asarray(y_pred_den, dtype=float))\n\n    # ---- komponen dekomposisi, ICEEMDAN, VMD, normalisasi, ringkasan min-max ----\n    comps, ice_data = _muat_dekomposisi(folder, list(sub_mode_preds.keys()))\n    if metode == \"Hybrid ICEEMDAN-GRU\" and not ice_data:\n        ice_data = dict(comps)\n    if metode == \"GRU\" and not comps:\n        comps = {\"GRU\": list(visitors_clean)}\n    _, vmd_modes = _turunan_dari_comps(comps, metode)\n    vmd_data = {\"params\": [], \"modes\": vmd_modes}\n    norm_data = _norm_minmax(comps) if comps else {}\n\n    n_uji = min(len(a) for a in y_preds_den_list)\n    pred_uji_total = np.sum([a[-n_uji:] for a in y_preds_den_list], axis=0)\n    split_idx = len(visitors_clean) - n_uji\n    aktual_uji = visitors_clean[split_idx:]\n    tgl_uji = dates[split_idx:]\n\n    akt = np.asarray(aktual_uji, dtype=float)\n    mae = float(np.mean(np.abs(akt - pred_uji_total)))\n    rmse = _rmse(akt, pred_uji_total)\n    mape = _mape(akt, pred_uji_total)\n\n    # Skala normalisasi total (sama seperti notebook: min-max data asli, clip 0-1)\n    rng_all = max(v_max - v_min, 1e-8)\n    akt_norm_a = (akt - v_min) / rng_all\n    pred_norm_a = np.clip((pred_uji_total - v_min) / rng_all, 0.0, 1.0)\n\n    # ---- Prediksi 12 bulan ke depan ----\n    fut_p = os.path.join(folder, \"hasil-prediksi-future\", \"future_predictions_12_months.csv\")\n    if not os.path.exists(fut_p):\n        raise _Gagal(f\"File tidak ada: {fut_p}\")\n    try:\n        df_fut = pd.read_csv(fut_p)\n        tgl_fut = pd.to_datetime(df_fut[\"Date\"]).dt.strftime(\"%Y-%m-%d\").tolist()\n        pred_fut = [float(round(v)) for v in df_fut[\"Predicted_Visitors\"]]\n    except Exception as e:\n        raise _Gagal(f\"File prediksi future tidak terbaca ({fut_p}): {e}\")\n    if not tgl_fut:\n        raise _Gagal(f\"File prediksi future kosong: {fut_p}\")\n\n    # ---- Grafik PNG notebook ----\n    png_map = {}\n    grafik_dir = os.path.join(folder, \"output_hasil\", \"grafik\")\n    if os.path.isdir(grafik_dir):\n        for fn in os.listdir(grafik_dir):\n            if fn.lower().endswith(\".png\"):\n                png_map[fn] = os.path.join(grafik_dir, fn).replace(\"\\\\\", \"/\")\n\n    return {\n        \"destinasi\": destinasi,\n        \"metode\": metode,\n        \"tgl_hist\": dates,\n        \"aktual_hist\": visitors_clean,\n        \"raw_hist\": raw_visitors,\n        \"gap_log\": gap_log,\n        \"split_idx\": int(split_idx),\n        \"tgl_uji\": tgl_uji,\n        \"aktual_uji\": aktual_uji,\n        \"prediksi_uji\": pred_uji_total.tolist(),\n        \"mae\": mae,\n        \"rmse\": rmse,\n        \"mape\": mape,\n        \"mae_norm\": float(np.mean(np.abs(akt_norm_a - pred_norm_a))),\n        \"rmse_norm\": _rmse(akt_norm_a, pred_norm_a),\n        \"mape_norm\": _mape(akt_norm_a, pred_norm_a),\n        \"actual_test_signal_norm\": akt_norm_a.tolist(),\n        \"x_pred_norm_final\": pred_norm_a.tolist(),\n        \"tgl_fut\": tgl_fut,\n        \"prediksi_fut\": pred_fut,\n        \"comps\": comps,\n        \"ice_data\": ice_data,\n        \"vmd_data\": vmd_data,\n        \"norm_data\": norm_data,\n        \"min_max_summary\": min_max_summary,\n        \"sub_mode_preds\": sub_mode_preds,\n        \"png_map\": png_map,\n        \"n_komponen\": len(comps),\n        \"folder\": folder,\n        \"loaded_from_folder\": True,\n    }\n\n\nLAST_ERROR = {\"msg\": \"\"}\n\n\ndef muat_hasil_folder(folder, destinasi, metode):\n    \"\"\"API lama: kembalikan dict hasil atau None (alasan di LAST_ERROR['msg']).\"\"\"\n    try:\n        LAST_ERROR[\"msg\"] = \"\"\n        return _muat_inti(folder, destinasi, metode)\n    except _Gagal as e:\n        LAST_ERROR[\"msg\"] = str(e)\n        return None\n\n\ndef _signature(folder):\n    \"\"\"Tanda perubahan folder: berubah bila ada file hasil yang diganti/ditambah.\"\"\"\n    patt = [\"hasil-interpolasi/*.xlsx\", \"hasil-dekomposisi/*.csv\", \"retrain-preds/*.csv\",\n            \"scaler/*.pkl\", \"hasil-prediksi-future/*.csv\", \"hasil-normalisasi/*\"]\n    tot, mx = 0, 0.0\n    for p in patt:\n        for f in glob.glob(os.path.join(folder, p)):\n            try:\n                mx = max(mx, os.path.getmtime(f))\n                tot += 1\n            except Exception:\n                pass\n    return f\"{tot}:{mx}\"\n\n\ndef _muat_cached(folder, destinasi, metode, sig):\n    \"\"\"Mengembalikan (hasil, alasan). Hanya hasil sukses yang berguna di-cache; kegagalan\n    ikut ter-cache tetapi kunci cache memuat signature folder sehingga otomatis ter-refresh\n    begitu file diperbaiki.\"\"\"\n    try:\n        return _muat_inti(folder, destinasi, metode), \"\"\n    except _Gagal as e:\n        return None, str(e)\n\n\n# Cache agar interaksi widget (rerun Streamlit) tidak membaca ulang file Excel/CSV.\nif st is not None and hasattr(st, \"cache_data\"):\n    _muat_cached = st.cache_data(show_spinner=False)(_muat_cached)\n\n\n# ============================================================\n# FALLBACK: TRAINING ULANG (LAMBAT, HANYA JIKA FOLDER TIDAK ADA)\n# ============================================================\ndef _cache_decomp(nama, sinyal, fungsi):\n    import joblib\n    import hashlib\n    os.makedirs(fe.CACHE_DIR, exist_ok=True)\n    hs = hashlib.sha1(nama.encode() + sinyal.tobytes()).hexdigest()\n    f = os.path.join(fe.CACHE_DIR, f\"decomp_adm_{hs}.pkl\")\n    if os.path.exists(f):\n        try:\n            return joblib.load(f)\n        except Exception:\n            pass\n    hasil = fungsi()\n    try:\n        joblib.dump(hasil, f)\n    except Exception:\n        pass\n    return hasil\n\n\ndef _komponen(destinasi, metode, sinyal):\n    if metode == \"Hybrid ICEEMDAN-GRU\":\n        def _ice():\n            modes = fe.iceemdan(sinyal)\n            comps = {f\"IMF_{i + 1}\": m for i, m in enumerate(modes[:-1])}\n            comps[\"ICEEMDAN_Residue\"] = modes[-1]\n            return comps\n        return _cache_decomp(\"ice_only\", sinyal, _ice)\n\n    if metode == \"Hybrid VMD-GRU\":\n        cfg = fe.CONFIG.get(destinasi, {})\n        if cfg.get(\"metode\") == \"vmd\":\n            K, alpha = cfg[\"K\"], cfg[\"alpha\"]\n        else:\n            K, alpha = VMD_K_STANDAR, VMD_ALPHA_STANDAR\n\n        def _v():\n            u = fe._vmd(sinyal, alpha, K)\n            return {f\"VMD_{k + 1}\": u[k] for k in range(K)}\n        return _cache_decomp(f\"vmd_{K}_{alpha}\", sinyal, _v)\n\n    return {\"GRU\": sinyal}          # GRU murni tanpa dekomposisi\n\n\ndef _lengkapi(h, comps=None):\n    \"\"\"Isi field yang dibutuhkan UI agar hasil fallback tidak membuat error.\"\"\"\n    h.setdefault(\"raw_hist\", list(h.get(\"aktual_hist\", [])))\n    h.setdefault(\"gap_log\", [])\n    h.setdefault(\"png_map\", {})\n    h.setdefault(\"sub_mode_preds\", {})\n    h.setdefault(\"loaded_from_folder\", False)\n    if comps:\n        comps = {k: [float(x) for x in v] for k, v in comps.items()}\n        h.setdefault(\"comps\", comps)\n        ice, vmd = _turunan_dari_comps(comps, h.get(\"metode\", \"\"))\n        h.setdefault(\"ice_data\", ice)\n        h.setdefault(\"vmd_data\", {\"params\": [], \"modes\": vmd})\n        h.setdefault(\"norm_data\", _norm_minmax(comps))\n        h.setdefault(\"min_max_summary\", _ringkas_minmax(comps))\n    return h\n\n\ndef _latih_ulang(destinasi, data_clean, metode, progress=None):\n    def lapor(f, t):\n        if progress:\n            progress(min(max(f, 0.0), 1.0), t)\n\n    sinyal = data_clean[\"visitors\"].values.astype(float)\n    dates = pd.to_datetime(data_clean[\"date\"]).reset_index(drop=True)\n    N = len(sinyal)\n    split_idx = int(N * (1 - fe.TEST_RATIO))\n\n    lapor(0.02, \"Menyiapkan data & dekomposisi sinyal...\")\n    comps = _komponen(destinasi, metode, sinyal)\n\n    table = {}\n    if metode == \"Hybrid VMD-GRU\" and fe.CONFIG.get(destinasi, {}).get(\"metode\") == \"vmd\":\n        table = fe.parse_table(fe.CONFIG[destinasi][\"tabel\"])\n\n    total = len(comps)\n    pred_uji_total = np.zeros(N - split_idx)\n    pred_fut_total = np.zeros(fe.HORIZON)\n    n_default = 0\n    lapor(0.12, \"Menyiapkan model prediksi...\")\n    for i, (name, seri) in enumerate(comps.items()):\n        par = table.get(name)\n        if par is None:\n            par = PARAM_STANDAR\n            n_default += 1\n        pu, pf = fe._latih_dan_prediksi(seri, par, seed=42 + i)\n        pred_uji_total += pu\n        pred_fut_total += pf\n        lapor(0.12 + 0.86 * (i + 1) / total, f\"Memproses model {i + 1} dari {total}...\")\n\n    try:\n        import tensorflow as tf\n        tf.keras.backend.clear_session()\n    except Exception:\n        pass\n    gc.collect()\n\n    pred_fut_total = np.maximum(pred_fut_total, 0.0)\n    aktual_uji = sinyal[split_idx:]\n    tgl_uji = dates.iloc[split_idx:]\n    tgl_fut = pd.date_range(dates.iloc[-1] + pd.DateOffset(months=1),\n                            periods=fe.HORIZON, freq=\"MS\")\n    lapor(1.0, \"Selesai\")\n    hasil = {\n        \"destinasi\": destinasi,\n        \"metode\": metode,\n        \"tgl_hist\": [d.strftime(\"%Y-%m-%d\") for d in dates],\n        \"aktual_hist\": [float(v) for v in sinyal],\n        \"split_idx\": int(split_idx),\n        \"tgl_uji\": [d.strftime(\"%Y-%m-%d\") for d in tgl_uji],\n        \"aktual_uji\": [float(v) for v in aktual_uji],\n        \"prediksi_uji\": [float(v) for v in pred_uji_total],\n        \"mae\": fe.hitung_mae(aktual_uji, pred_uji_total),\n        \"mape\": fe.hitung_mape(aktual_uji, pred_uji_total),\n        \"tgl_fut\": [d.strftime(\"%Y-%m-%d\") for d in tgl_fut],\n        \"prediksi_fut\": [float(round(v)) for v in pred_fut_total],\n        \"n_komponen\": int(total),\n        \"n_param_default\": int(n_default),\n    }\n    return _lengkapi(hasil, comps)\n\n\ndef _hentikan(pesan):\n    \"\"\"Tampilkan pesan jelas lalu hentikan (tanpa training ulang diam-diam).\"\"\"\n    if st is not None:\n        st.error(pesan)\n        st.stop()\n    raise FileNotFoundError(pesan)\n\n\ndef jalankan_metode(destinasi, data_clean, metode, progress=None):\n    \"\"\"Muat hasil dari folder notebook untuk SEMUA metode (cepat).\n    Training ulang hanya sebagai fallback jika folder/file tidak lengkap\n    (kecuali metode+destinasi di WAJIB_DARI_FOLDER, mis. ICEEMDAN-GRU 4 destinasi notebook).\"\"\"\n    def lapor(f, t):\n        if progress:\n            progress(min(max(f, 0.0), 1.0), t)\n\n    lapor(0.15, f\"Mencari file hasil eksperimen untuk {metode}...\")\n    fol = cari_folder(metode, destinasi)\n    alasan = \"\"\n    if fol:\n        lapor(0.40, f\"Memuat hasil ({os.path.basename(fol)})...\")\n        res, alasan = _muat_cached(fol, destinasi, metode, _signature(fol))\n        if res:\n            lapor(1.0, \"Selesai\")\n            return res\n    else:\n        alasan = (\"Folder hasil tidak ditemukan. Dicari di: \"\n                  + \"; \".join(_daftar_dicari(metode)) + f\"/<{destinasi}>/hasil-interpolasi/...\")\n\n    if destinasi.lower() in WAJIB_DARI_FOLDER.get(metode, set()):\n        _hentikan(\n            f\"Hasil notebook **{metode}** untuk **{destinasi}** tidak dapat dimuat.\\n\\n\"\n            f\"Alasan: {alasan}\\n\\n\"\n            \"Pastikan folder hasil notebook diletakkan sebagai \"\n            f\"`{METHOD_FOLDERS.get(metode)}/<nama destinasi>/` yang berisi: `hasil-interpolasi/`, \"\n            \"`hasil-dekomposisi/`, `hasil-normalisasi/`, `scaler/`, `retrain-preds/`, \"\n            \"`hasil-prediksi-future/`, `output_hasil/`.\")\n\n    # ---- Fallback (lambat) ----\n    lapor(0.02, \"Folder hasil tidak lengkap, menjalankan ulang model...\")\n    if metode == \"Hybrid ICEEMDAN-VMD-GRU\":\n        res = fe.jalankan_prediksi(destinasi, data_clean, progress=progress)\n        if isinstance(res, dict):\n            res.setdefault(\"metode\", metode)\n            _lengkapi(res)\n        return res\n    return _latih_ulang(destinasi, data_clean, metode, progress=progress)\n\n\n# ============================================================\n# FUNGSI GRAFIK PLOTLY\n# ============================================================\ndef fig_interpolasi(h):\n    if go is None:\n        return None\n    tgl = pd.to_datetime(h[\"tgl_hist\"])\n    cd = [_tgl_id(d) for d in h[\"tgl_hist\"]]\n    fig = go.Figure()\n    fig.add_trace(go.Scatter(\n        x=tgl, y=h[\"aktual_hist\"], mode=\"lines\", name=\"Hasil Interpolasi Linear (Trend)\",\n        line=dict(color=\"#0284c7\", width=2.4), customdata=cd,\n        hovertemplate=\"Hasil Interpolasi: %{y:,.0f}<br>Tanggal: %{customdata}<extra></extra>\"\n    ))\n    fig.add_trace(go.Scatter(\n        x=tgl, y=h[\"raw_hist\"], mode=\"lines+markers\", name=\"Data Asli (Sebelum Interpolasi)\",\n        line=dict(color=\"#1e293b\", width=1.5), marker=dict(size=4, color=\"#0f172a\"),\n        customdata=cd,\n        hovertemplate=\"Data Asli: %{y:,.0f}<br>Tanggal: %{customdata}<extra></extra>\"\n    ))\n    if h.get(\"gap_log\"):\n        gap_dates = [pd.to_datetime(r[\"date\"]) for r in h[\"gap_log\"]]\n        gap_vals = [r.get(\"new_value\", 0) for r in h[\"gap_log\"]]\n        fig.add_trace(go.Scatter(\n            x=gap_dates, y=gap_vals, mode=\"markers\", name=\"Titik Gap (Nilai 0 Diimputasi)\",\n            marker=dict(size=8, color=\"#ef4444\", symbol=\"diamond\"),\n            hovertemplate=\"Imputasi Gap: %{y:,.0f}<extra></extra>\"\n        ))\n    fig.update_layout(yaxis_title=\"Jumlah Pengunjung\", xaxis_title=\"Tahun & Bulan\")\n    return _base_layout(fig, h=400)\n\n\ndef fig_iceemdan(h):\n    if go is None or make_subplots is None:\n        return None\n    ice_items = list(h.get(\"ice_data\", {}).items())\n    if not ice_items:\n        return None\n    tgl = pd.to_datetime(h[\"tgl_hist\"])\n    n_ice = len(ice_items)\n    titles = [k.replace(\"_\", \" \") for k, _ in ice_items]\n    fig = make_subplots(rows=n_ice, cols=1, shared_xaxes=True,\n                        vertical_spacing=min(0.035, 0.9 / max(n_ice, 1)),\n                        subplot_titles=titles)\n    colors = [\"#1e293b\", \"#0284c7\", \"#0d9488\", \"#16a34a\", \"#ca8a04\", \"#ea580c\", \"#dc2626\", \"#9333ea\"]\n    for idx, (k, vals) in enumerate(ice_items):\n        fig.add_trace(go.Scatter(\n            x=tgl, y=vals, mode=\"lines\", name=k,\n            line=dict(color=colors[idx % len(colors)], width=1.8), showlegend=False,\n            hovertemplate=f\"{k}: %{{y:,.2f}}<extra></extra>\"\n        ), row=idx + 1, col=1)\n    fig.update_layout(\n        height=max(140 * n_ice, 520), plot_bgcolor=\"#ffffff\", paper_bgcolor=\"#ffffff\",\n        margin=dict(l=10, r=10, t=30, b=10),\n        font=dict(family=\"Plus Jakarta Sans, sans-serif\", size=11, color=\"#334155\"))\n    return fig\n\n\ndef fig_vmd(h, max_modes=12):\n    if go is None:\n        return None\n    vmd_modes = h.get(\"vmd_data\", {}).get(\"modes\", {})\n    if not vmd_modes:\n        return None\n    tgl = pd.to_datetime(h[\"tgl_hist\"])\n    fig = go.Figure()\n    for m_name, m_vals in list(vmd_modes.items())[:max_modes]:\n        fig.add_trace(go.Scatter(\n            x=tgl, y=m_vals, mode=\"lines\", name=m_name, line=dict(width=1.5),\n            hovertemplate=f\"{m_name}: %{{y:,.2f}}<extra></extra>\"\n        ))\n    fig.update_layout(yaxis_title=\"Nilai Amplitudo Sub-Mode\", xaxis_title=\"Periode Waktu\")\n    return _base_layout(fig, h=420)\n\n\ndef fig_normalisasi(h, comp_name=None):\n    if go is None or make_subplots is None:\n        return None\n    comps = h.get(\"comps\", {})\n    norm_d = h.get(\"norm_data\", {})\n    if not comps:\n        return None\n    if not comp_name or comp_name not in comps:\n        comp_name = list(comps.keys())[0]\n\n    tgl = pd.to_datetime(h[\"tgl_hist\"])\n    y_raw = comps[comp_name]\n    y_norm = norm_d.get(comp_name) or _norm_minmax({comp_name: y_raw})[comp_name]\n\n    fig = make_subplots(\n        rows=1, cols=2, horizontal_spacing=0.08,\n        subplot_titles=[f\"Sebelum Normalisasi (Skala Asli) — {comp_name}\",\n                        f\"Sesudah Normalisasi (Skala 0–1 Min-Max) — {comp_name}\"])\n    fig.add_trace(go.Scatter(\n        x=tgl, y=y_raw, mode=\"lines\", name=\"Skala Asli\",\n        line=dict(color=\"#0284c7\", width=2.0),\n        hovertemplate=\"Nilai Asli: %{y:,.2f}<extra></extra>\"), row=1, col=1)\n    fig.add_trace(go.Scatter(\n        x=tgl, y=y_norm, mode=\"lines\", name=\"Skala [0, 1]\",\n        line=dict(color=\"#10b981\", width=2.0),\n        hovertemplate=\"Normalisasi: %{y:.4f}<extra></extra>\"), row=1, col=2)\n    fig.update_yaxes(title_text=\"Nilai Asli\", row=1, col=1)\n    fig.update_yaxes(title_text=\"Value (0–1)\", range=[-0.05, 1.05], row=1, col=2)\n    fig.update_layout(\n        height=380, plot_bgcolor=\"#ffffff\", paper_bgcolor=\"#ffffff\",\n        margin=dict(l=10, r=10, t=35, b=10),\n        font=dict(family=\"Plus Jakarta Sans, sans-serif\", size=11, color=\"#334155\"))\n    return fig\n\n\ndef fig_denormalisasi(h, comp_name=None):\n    \"\"\"Tidak dipakai di menu (denormalisasi tidak ditampilkan), disediakan bila dibutuhkan.\"\"\"\n    if go is None or make_subplots is None:\n        return None\n    sub_preds = h.get(\"sub_mode_preds\", {})\n    tgl_uji = pd.to_datetime(h[\"tgl_uji\"])\n\n    if comp_name and comp_name in sub_preds:\n        d = sub_preds[comp_name]\n        s1 = (f\"1. {comp_name} — Skala [0, 1] (MAE = {d['mae_norm']:.4f} | \"\n              f\"MAPE = {d['mape_norm']:.2f}%)\")\n        s2 = (f\"2. {comp_name} — Skala Asli (MAE = {_fmt_id(d.get('mae_den', 0), 2)} | \"\n              f\"MAPE = {_fmt_id(d.get('mape_den', 0), 2)}%)\")\n        y1a, y1p, y2a, y2p = d[\"y_true_norm\"], d[\"y_pred_norm\"], d[\"y_true_den\"], d[\"y_pred_den\"]\n    else:\n        s1 = \"1. Rekonstruksi Prediksi vs Aktual (Normalisasi 0–1)\"\n        s2 = (f\"2. Rekonstruksi Prediksi vs Aktual (Skala Asli) — MAE = {_fmt_id(h['mae'], 2)} | \"\n              f\"MAPE = {_fmt_id(h['mape'], 2)}%\")\n        y1a, y1p = h.get(\"actual_test_signal_norm\", []), h.get(\"x_pred_norm_final\", [])\n        y2a, y2p = h[\"aktual_uji\"], h[\"prediksi_uji\"]\n\n    fig = make_subplots(rows=2, cols=1, shared_xaxes=True, vertical_spacing=0.12,\n                        subplot_titles=[s1, s2])\n    for row, (ya, yp) in enumerate([(y1a, y1p), (y2a, y2p)], start=1):\n        fig.add_trace(go.Scatter(x=tgl_uji, y=ya, mode=\"lines+markers\", name=\"Aktual\",\n                                 line=dict(color=\"#1f77b4\", width=2.2), marker=dict(size=6),\n                                 showlegend=(row == 1)), row=row, col=1)\n        fig.add_trace(go.Scatter(x=tgl_uji, y=yp, mode=\"lines+markers\", name=\"Prediksi\",\n                                 line=dict(color=\"#ff7f0e\", width=1.8, dash=\"dash\"),\n                                 marker=dict(size=7, symbol=\"x\"),\n                                 showlegend=(row == 1)), row=row, col=1)\n    fig.update_yaxes(title_text=\"Value (0–1)\", range=[-0.05, 1.05], row=1, col=1)\n    fig.update_yaxes(title_text=\"Nilai\", tickformat=\",.0f\", row=2, col=1)\n    fig.update_layout(\n        height=680, plot_bgcolor=\"#ffffff\", paper_bgcolor=\"#ffffff\",\n        margin=dict(l=10, r=10, t=55, b=10), hovermode=\"x unified\",\n        font=dict(family=\"Plus Jakarta Sans, sans-serif\", size=11, color=\"#334155\"),\n        legend=dict(orientation=\"h\", yanchor=\"bottom\", y=1.03, xanchor=\"left\", x=0))\n    fig.update_xaxes(tickformat=\"%b %Y\", dtick=\"M2\")\n    return fig\n\n\ndef fig_aktual_prediksi(h):\n    if go is None:\n        return None\n    tgl = pd.to_datetime(h[\"tgl_hist\"])\n    tgl_uji = pd.to_datetime(h[\"tgl_uji\"])\n    fig = go.Figure()\n    fig.add_vrect(\n        x0=tgl_uji[0], x1=tgl_uji[-1], fillcolor=\"rgba(249,115,22,0.07)\", line_width=0,\n        annotation_text=\"Periode uji\", annotation_position=\"top left\",\n        annotation_font=dict(size=11, color=\"#c2410c\"))\n    fig.add_trace(go.Scatter(\n        x=tgl, y=h[\"aktual_hist\"], name=\"Aktual\", mode=\"lines\",\n        line=dict(color=\"#0284c7\", width=2.4),\n        customdata=[_tgl_id(d) for d in h[\"tgl_hist\"]],\n        hovertemplate=\"Aktual: %{y:,.0f}<extra></extra>\"))\n    fig.add_trace(go.Scatter(\n        x=tgl_uji, y=h[\"prediksi_uji\"], name=\"Prediksi\", mode=\"lines+markers\",\n        line=dict(color=\"#f97316\", width=2.4, dash=\"dash\"), marker=dict(size=6),\n        hovertemplate=\"Prediksi: %{y:,.0f}<extra></extra>\"))\n    return _base_layout(fig, h=380)\n\n\ndef fig_masa_depan(h):\n    if go is None:\n        return None\n    n_tampil = 36\n    tgl = pd.to_datetime(h[\"tgl_hist\"])[-n_tampil:]\n    akt = h[\"aktual_hist\"][-n_tampil:]\n    tgl_f = pd.to_datetime(h[\"tgl_fut\"])\n    fig = go.Figure()\n    fig.add_vrect(\n        x0=tgl_f[0], x1=tgl_f[-1], fillcolor=\"rgba(13,148,136,0.07)\", line_width=0,\n        annotation_text=\"12 bulan ke depan\", annotation_position=\"top left\",\n        annotation_font=dict(size=11, color=\"#0f766e\"))\n    fig.add_trace(go.Scatter(\n        x=tgl, y=akt, name=\"Data historis\", mode=\"lines\",\n        line=dict(color=\"#0284c7\", width=2.4),\n        hovertemplate=\"Aktual: %{y:,.0f}<extra></extra>\"))\n    fig.add_trace(go.Scatter(\n        x=[tgl[-1], tgl_f[0]], y=[akt[-1], h[\"prediksi_fut\"][0]],\n        mode=\"lines\", showlegend=False, hoverinfo=\"skip\",\n        line=dict(color=\"#0d9488\", width=1.6, dash=\"dot\")))\n    fig.add_trace(go.Scatter(\n        x=tgl_f, y=h[\"prediksi_fut\"], name=\"Prediksi 12 bulan\",\n        mode=\"lines+markers\", line=dict(color=\"#0d9488\", width=2.6, dash=\"dash\"),\n        marker=dict(size=7), hovertemplate=\"Prediksi: %{y:,.0f}<extra></extra>\"))\n    _base_layout(fig, h=380)\n    fig.update_xaxes(tickformat=\"%b %Y\", dtick=\"M6\")   # setelah layout agar tidak tertimpa\n    return fig\n\n\n# ============================================================\n# MENU TAHAPAN PER METODE\n# ============================================================\n\nOPSI_PER_METODE = {\n    \"Hybrid ICEEMDAN-VMD-GRU\": [\"Interpolasi Linear\", \"Dekomposisi I-CEEMDAN\", \"Dekomposisi VMD\",\n                                \"Normalisasi\", \"Evaluasi & Prediksi\"],\n    \"Hybrid ICEEMDAN-GRU\": [\"Interpolasi Linear\", \"Dekomposisi I-CEEMDAN\",\n                            \"Normalisasi\", \"Evaluasi & Prediksi\"],\n    \"Hybrid VMD-GRU\": [\"Interpolasi Linear\", \"Dekomposisi VMD\",\n                       \"Normalisasi\", \"Evaluasi & Prediksi\"],\n    \"GRU\": [\"Interpolasi Linear\", \"Normalisasi\", \"Evaluasi & Prediksi\"],\n}\n\n\ndef _menu_tahapan(opsi, key):\n    \"\"\"Menu satu baris (segmented control); fallback radio horizontal.\"\"\"\n    if st.session_state.get(key) not in (None, *opsi):\n        del st.session_state[key]\n    if key not in st.session_state:\n        st.session_state[key] = opsi[0]          # tab pertama = Interpolasi Linear\n\n    if hasattr(st, \"segmented_control\"):\n        kw = {}\n        if \"width\" in inspect.signature(st.segmented_control).parameters:\n            kw[\"width\"] = \"stretch\"\n        pilihan = st.segmented_control(\n            \"Pilih Visualisasi Tahapan:\", opsi, selection_mode=\"single\",\n            key=key, label_visibility=\"collapsed\", **kw)\n        if pilihan is None:          # klik ulang tab aktif -> tetap di tab sebelumnya\n            pilihan = st.session_state.get(f\"_tahap_{key}\", opsi[0])\n            st.session_state[key] = pilihan\n    else:\n        pilihan = st.radio(\"Pilih Visualisasi Tahapan:\", opsi, horizontal=True,\n                           key=key, label_visibility=\"collapsed\")\n    st.session_state[f\"_tahap_{key}\"] = pilihan\n    return pilihan\n\n\n# ============================================================\n# DETAIL EVALUASI SEPERTI NOTEBOOK (RMSE, per-komponen, grafik PNG)\n# ============================================================\ndef _render_detail_notebook(h, kp):\n    \"\"\"Ringkasan tambahan yang sama dengan output notebook (sel evaluasi & future).\"\"\"\n    if not h.get(\"loaded_from_folder\"):\n        return\n    st.write(\"\")\n    with st.container(border=True):\n        _head(\"Ringkasan Evaluasi Seperti Notebook\",\n              \"Metrik rekonstruksi akhir (jumlah seluruh sub-komponen) pada data uji\")\n        c1, c2, c3 = st.columns(3, gap=\"medium\")\n        with c1:\n            _mcard(\"a\", \"MAE (SKALA ASLI)\", _fmt_id(h[\"mae\"], 2), \"pengunjung\")\n        with c2:\n            _mcard(\"b\", \"RMSE (SKALA ASLI)\", _fmt_id(h.get(\"rmse\"), 2), \"pengunjung\")\n        with c3:\n            _mcard(\"a\", \"MAPE (SKALA ASLI)\", _fmt_id(h[\"mape\"], 2) + \"%\", \"persentase kesalahan\")\n        if h.get(\"mae_norm\") is not None:\n            st.caption(f\"Skala normalisasi 0–1: MAE = {h['mae_norm']:.4f} | \"\n                       f\"RMSE = {h['rmse_norm']:.4f} | MAPE = {h['mape_norm']:.2f}%\")\n\n        sub = h.get(\"sub_mode_preds\", {})\n        if sub:\n            with st.expander(\"Lihat metrik evaluasi per sub-komponen (IMF & Residu)\"):\n                rows = [{\n                    \"Sub-Komponen\": k,\n                    \"MAE (Norm)\": round(d[\"mae_norm\"], 4),\n                    \"RMSE (Norm)\": round(d.get(\"rmse_norm\", float(\"nan\")), 4),\n                    \"MAPE (Norm) %\": round(d[\"mape_norm\"], 2),\n                    \"MAE (Skala Asli)\": round(d[\"mae_den\"], 4),\n                    \"RMSE (Skala Asli)\": round(d.get(\"rmse_den\", float(\"nan\")), 4),\n                    \"MAPE (Skala Asli) %\": round(d[\"mape_den\"], 2),\n                } for k, d in sub.items()]\n                _show_df(pd.DataFrame(rows), hide_index=True)\n\n        with st.expander(\"Lihat tabel aktual vs prediksi rekonstruksi (data uji)\"):\n            akt = np.asarray(h[\"aktual_uji\"], dtype=float)\n            prd = np.asarray(h[\"prediksi_uji\"], dtype=float)\n            _show_df(pd.DataFrame({\n                \"Bulan\": [_tgl_id(d) for d in h[\"tgl_uji\"]],\n                \"Aktual\": [_fmt_id(v) for v in akt],\n                \"Prediksi\": [_fmt_id(v) for v in prd],\n                \"Selisih Absolut\": [_fmt_id(v) for v in np.abs(akt - prd)],\n            }), hide_index=True)\n\n        png_list = [\n            (\"06_final_reconstruction_prediction_norm.png\", \"Rekonstruksi prediksi (skala 0–1)\"),\n            (\"07_final_reconstruction_prediction_original_scale.png\",\n             \"Rekonstruksi prediksi (skala asli)\"),\n            (\"08_future_predictions_12_months.png\", \"Proyeksi 12 bulan ke depan\"),\n        ]\n        ada = [(n, c) for n, c in png_list\n               if h.get(\"png_map\", {}).get(n) and os.path.exists(h[\"png_map\"][n])]\n        if ada:\n            with st.expander(\"Lihat grafik evaluasi dari notebook (PNG)\"):\n                for n, c in ada:\n                    _show_img(h[\"png_map\"][n], c)\n\n\n# ============================================================\n# RENDER HASIL ADMIN (SEMUA METODE)\n# ============================================================\ndef render_hasil_admin(h, render_user=None, raw_df=None):\n    if st is None:\n        return\n    metode = h.get(\"metode\", \"Hybrid ICEEMDAN-VMD-GRU\")\n    opsi = OPSI_PER_METODE.get(metode, OPSI_PER_METODE[\"GRU\"])\n    kp = \"adm_\" + metode.replace(\" \", \"_\").replace(\"-\", \"_\")\n\n    with st.container(border=True):\n        _head(\"Pilih Visualisasi Tahapan\",\n              f\"Alur {metode.replace('Hybrid ', '')}: dari data aktual sampai hasil peramalan\")\n        pilihan = _menu_tahapan(opsi, key=f\"{kp}_menu\")\n    st.write(\"\")\n\n    # Tahap pra-proses (khusus ICEEMDAN-VMD-GRU); evaluasi & prediksi tetap seperti semula\n    if pilihan != \"Evaluasi & Prediksi\":\n        if metode == \"Hybrid ICEEMDAN-VMD-GRU\":\n            render_tahap_praproses(h, pilihan, kp, raw_df)\n        return\n\n    # ---------------- Evaluasi & Prediksi (TIDAK DIUBAH) ----------------\n    # ... biarkan seluruh isi lama mulai dari `if True:` sampai akhir fungsi ...\n\n    # ---------------- Evaluasi & Prediksi ----------------\n    if True:\n        if render_user is not None:\n            render_user(h)\n            _render_detail_notebook(h, kp)\n            return\n        if not _butuh(h, \"tgl_uji\", \"tgl_fut\"):\n            return\n        c1, c2 = st.columns(2, gap=\"medium\")\n        with c1:\n            _mcard(\"a\", \"MAE (Mean Absolute Error)\", _fmt_id(h[\"mae\"], 2),\n                   \"rata-rata selisih absolut aktual dan prediksi \")\n        with c2:\n            _mcard(\"b\", \"MAPE (Mean Absolute Percentage Error)\", _fmt_id(h[\"mape\"], 2) + \"%\",\n                   \"rata-rata persentase kesalahan prediksi\")\n        with st.container(border=True):\n            _head(\"Visualisasi Data Aktual dan Prediksi\",\n                  f'Evaluasi pada periode uji {_tgl_id(h[\"tgl_uji\"][0])} – '\n                  f'{_tgl_id(h[\"tgl_uji\"][-1])} ({len(h[\"tgl_uji\"])} bulan)')\n            _show_chart(fig_aktual_prediksi(h), key=f\"{kp}_aktual\")\n        st.write(\"\")\n        with st.container(border=True):\n            _head(\"Prediksi Kunjungan 12 Bulan ke Depan\",\n                  f'{_tgl_id(h[\"tgl_fut\"][0])} – {_tgl_id(h[\"tgl_fut\"][-1])}')\n            _show_chart(fig_masa_depan(h), key=f\"{kp}_future\")\n            with st.expander(\"Lihat tabel prediksi\"):\n                _show_df(pd.DataFrame({\n                    \"Bulan\": [_tgl_id(d) for d in h[\"tgl_fut\"]],\n                    \"Prediksi Pengunjung\": [_fmt_id(v) for v in h[\"prediksi_fut\"]],\n                }), hide_index=True)\n        _render_detail_notebook(h, kp)\n\n\n# Alias agar pemanggil lama tetap berjalan\nrender_hasil_iceemdan_vmd_gru = render_hasil_admin\n\n\n# === AKHIR FILE admin_methods.py (jika baris ini tidak ada di file Anda, salinan terpotong) ===","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-05T15:55:39.877115Z","iopub.execute_input":"2026-11-05T15:55:39.877413Z","iopub.status.idle":"2026-11-05T15:55:39.931670Z","shell.execute_reply.started":"2026-11-05T15:55:39.877391Z","shell.execute_reply":"2026-11-05T15:55:39.930582Z"}},"outputs":[{"name":"stdout","text":"Overwriting admin_methods.py\n","output_type":"stream"}],"execution_count":11},{"cell_type":"markdown","source":"# TAMPILAN ","metadata":{}},{"cell_type":"code","source":"%%writefile app.py\nimport os\nimport io\nimport re\nimport base64\nimport requests\nimport folium\nimport streamlit as st\nimport streamlit.components.v1 as components\nfrom html import unescape\nfrom urllib.parse import urlparse, parse_qs, urljoin\n\n# ============================================================\n# KONFIGURASI\n# ============================================================\nst.set_page_config(\n    page_title=\"Prediksi Kunjungan Wisatawan Kabupaten Bangkalan\",\n    page_icon=\"🏝️\",\n    layout=\"wide\",\n    initial_sidebar_state=\"expanded\",\n)\n\nif \"page\" not in st.session_state:\n    st.session_state.page = \"landing\"\nif \"role\" not in st.session_state:\n    st.session_state.role = None\n\nADMIN_USER = \"admin\"\nADMIN_PASS = \"admin\"\nNAMA_PENGEMBANG = \"Alvyan Maulana Karnawan Putra\"\nPETA_STYLE = \"google\"           # \"google\" atau \"osm\"\n\n# Warna \"biru teknik\" untuk logo yang diberi \"recolor\": True (R, G, B)\nTEKNIK_BLUE = (30, 136, 229)\n\nASSETS = \"assets\"\nos.makedirs(ASSETS, exist_ok=True)\n\n# ============================================================\n# LOGO KIRI ATAS (urutan dari kiri ke kanan)\n# \"file\"   : nama file di assets/ (dipakai lebih dulu jika ada)\n# \"url\"    : link gambar ATAU link halaman (gambar dicari otomatis)\n# \"dark\"   : True -> logo diberi latar biru tua gelap (untuk logo berwarna putih)\n# \"recolor\": True -> hitam jadi putih, putih jadi biru teknik\n# ============================================================\nLOGOS = [\n    {\"file\": \"logo_utm.jpg\", \"h\": 50, \"dark\": False, \"recolor\": False,\n     \"url\": \"https://www.instagram.com/p/De83c8qSJ6v/?exln=aWtueWYxaDk4ZDEw\"},\n    {\"file\": \"logo_ft.png\", \"h\": 46, \"dark\": False, \"recolor\": False,\n     \"url\": \"https://www.instagram.com/p/De83lZQSI8g/?srtk=MWg1eDc0ZjJ6dHhndA==\"},\n    {\"file\": \"logo_si.png\", \"h\": 46, \"dark\": False, \"recolor\": False,\n     \"url\": \"https://sivitas.sakera.id/images/logo-si.png\"},\n    {\"file\": \"logo_bangkalan.jpg\", \"h\": 52, \"dark\": False, \"recolor\": False,\n     \"url\": \"https://www.instagram.com/p/De832OMy3TG/?rpxt=YzY5bTdvaHVqNnlt\"},\n]\n\n# ============================================================\n# DATA DESTINASI\n# ============================================================\nDESTINASI = [\n    {\"nama\": \"Makam Syaikhona Kholil\", \"file\": \"syaikhona_kholil.jpg\", \"tag\": \"Wisata Religi\",\n     \"icon\": \"🕌\", \"grad\": \"#0ea5e9,#0d9488\", \"color\": \"#ef4444\",\n     \"url\": \"https://www.instagram.com/p/DXOb8I5k0WR/\",\n     \"desk\": \"Makam ulama besar Madura, destinasi wisata religi utama di Bangkalan.\",\n     \"lat\": -7.0450, \"lon\": 112.7340},\n    {\"nama\": \"Kolla Langgundi\", \"file\": \"langgundi.jpg\", \"tag\": \"Wisata Religi\",\n     \"icon\": \"🏛️\", \"grad\": \"#f59e0b,#ef4444\", \"color\": \"#f97316\",\n     \"url\": \"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh92G0yWlNc1fnYnq_qm52Dl195gR47Im6Ac5jJS47uz8aSiSq7wx7d1ojxVkuGp1ao_cyu9KeKJnkBti8n3nCErAjmT08oSEvXKNhTJRS6O9ZrIB7b6n9lpI6bzTwThx-_uWkKcd3pUKht/w640-h480-c/Wisata+Religi+Sultan+Abdul+Kadirun+Bangkalan.jpg\",\n     \"desk\": \"Kawasan wisata sejarah dan budaya khas Bangkalan.\",\n     \"lat\": -7.0300, \"lon\": 112.7600},\n    {\"nama\": \"Makam Sunan Cendana\", \"file\": \"cendana.jpg\", \"tag\": \"Wisata Religi\",\n     \"icon\": \"🌿\", \"grad\": \"#10b981,#0284c7\", \"color\": \"#22c55e\",\n     \"url\": \"https://www.haibunda.com/moms-life/20210726124816-77-228535/9-potret-astana-giribangun-makam-keluarga-cendana-dilengkapi-masjid-pasar\",\n     \"desk\": \"Wisata religi yang ramai dikunjungi peziarah dari berbagai daerah.\",\n     \"lat\": -7.0100, \"lon\": 112.7900},\n    {\"nama\": \"Makam Air Mata Ibu\", \"file\": \"air_mata_ibu.jpg\", \"tag\": \"Wisata Religi\",\n     \"icon\": \"🕊️\", \"grad\": \"#8b5cf6,#ec4899\", \"color\": \"#a855f7\",\n     \"url\": \"https://awsimages.detik.net.id/community/media/visual/2025/09/13/situs-makam-air-mata-ratu-ibu-1757752879199_169.png?w=1200\",\n     \"desk\": \"Makam Air Mata Ibu, destinasi wisata religi dengan nilai sejarah tinggi.\",\n     \"lat\": -7.0000, \"lon\": 112.8000},\n    {\"nama\": \"Gunung Geger\", \"file\": \"gunung_geger.jpg\", \"tag\": \"Wisata Alam\",\n     \"icon\": \"⛰️\", \"grad\": \"#22c55e,#0d9488\", \"color\": \"#0284c7\",\n     \"url\": \"https://kataomed.com/wp-content/uploads/2023/03/Camping-Ground-Geger-Bintang-Photo-by-Wisatainfo-e1680515282467.jpg\",\n     \"desk\": \"Destinasi wisata alam dengan jalur susur alam yang asri.\",\n     \"lat\": -7.1000, \"lon\": 112.9300},\n]\n\n\n# ============================================================\n# HELPER UMUM\n# ============================================================\ndef html(s: str):\n    \"\"\"Render HTML tanpa indentasi/baris kosong (hindari bug code-block markdown).\"\"\"\n    s = \"\\n\".join(l.strip() for l in s.splitlines() if l.strip())\n    st.markdown(s, unsafe_allow_html=True)\n\n\ndef goto(page: str, role=None):\n    st.session_state.page = page\n    if role is not None or page in (\"landing\", \"login\"):\n        st.session_state.role = role\n    st.rerun()\n\n\n# ============================================================\n# HELPER GAMBAR\n# ============================================================\nUA_BROWSER = (\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 \"\n              \"(KHTML, like Gecko) Chrome/124.0 Safari/537.36\")\nUA_CRAWLER = \"facebookexternalhit/1.1 (+http://www.facebook.com/externalhit_uatext.php)\"\n\n\ndef clean_url(url: str) -> str:\n    \"\"\"Jika berupa link Google 'imgres', ambil alamat gambar aslinya (parameter imgurl).\"\"\"\n    if url and \"google.\" in url and \"/imgres\" in url:\n        q = parse_qs(urlparse(url).query)\n        if q.get(\"imgurl\"):\n            return q[\"imgurl\"][0]\n    return url\n\n\ndef looks_like_image(url: str) -> bool:\n    return bool(re.search(r\"\\.(jpe?g|png|webp|gif)(\\?|$)\", url, re.I))\n\n\ndef sniff_mime(data: bytes):\n    \"\"\"Mengembalikan mime jika data benar-benar gambar, selain itu None.\"\"\"\n    if data[:8] == b\"\\x89PNG\\r\\n\\x1a\\n\":\n        return \"image/png\"\n    if data[:3] == b\"\\xff\\xd8\\xff\":\n        return \"image/jpeg\"\n    if data[:4] == b\"RIFF\" and data[8:12] == b\"WEBP\":\n        return \"image/webp\"\n    if data[:4] == b\"GIF8\":\n        return \"image/gif\"\n    return None\n\n\ndef shrink(data: bytes, max_side: int = 900) -> bytes:\n    \"\"\"Perkecil gambar. Transparansi (PNG) dipertahankan.\"\"\"\n    try:\n        from PIL import Image\n        im = Image.open(io.BytesIO(data))\n        has_alpha = im.mode in (\"RGBA\", \"LA\") or \"transparency\" in im.info\n        im = im.convert(\"RGBA\" if has_alpha else \"RGB\")\n        im.thumbnail((max_side, max_side))\n        buf = io.BytesIO()\n        if has_alpha:\n            im.save(buf, format=\"PNG\", optimize=True)\n        else:\n            im.save(buf, format=\"JPEG\", quality=85)\n        return buf.getvalue()\n    except Exception:\n        return data\n\n\ndef recolor_logo(data: bytes, blue=TEKNIK_BLUE) -> bytes:\n    \"\"\"Hitam -> putih, putih -> biru teknik (abu-abu diinterpolasi halus).\n    Piksel berwarna (mis. kuning/merah) tidak diubah.\"\"\"\n    try:\n        import numpy as np\n        from PIL import Image\n        im = Image.open(io.BytesIO(data)).convert(\"RGBA\")\n        a = np.array(im).astype(np.float32)\n        rgb = a[..., :3]\n        mx, mn = rgb.max(axis=2), rgb.min(axis=2)\n        sat = (mx - mn) / (mx + 1e-6)\n        lum = rgb.mean(axis=2) / 255.0\n        gray = sat < 0.25\n        white = np.array([255, 255, 255], dtype=np.float32)\n        blu = np.array(blue, dtype=np.float32)\n        t = lum[..., None]\n        mixed = (1 - t) * white + t * blu\n        out = a.copy()\n        out[..., :3] = np.where(gray[..., None], mixed, rgb)\n        buf = io.BytesIO()\n        Image.fromarray(out.astype(np.uint8), \"RGBA\").save(buf, format=\"PNG\")\n        return buf.getvalue()\n    except Exception:\n        return data\n\n\ndef to_uri(data: bytes) -> str:\n    return f\"data:{sniff_mime(data)};base64,{base64.b64encode(data).decode()}\"\n\n\ndef find_image_in_html(text: str, base: str):\n    \"\"\"Cari alamat gambar utama di sebuah halaman web (logo organisasi / og:image / logo).\"\"\"\n    pola = [\n        r'<img[^>]+src=[\"\\']([^\"\\']*uploads/(?:group|organization)/[^\"\\']+)',\n        r'<meta[^>]+property=[\"\\']og:image(?::secure_url)?[\"\\'][^>]+content=[\"\\']([^\"\\']+)',\n        r'<meta[^>]+content=[\"\\']([^\"\\']+)[\"\\'][^>]+property=[\"\\']og:image[\"\\']',\n        r'<meta[^>]+name=[\"\\']twitter:image[\"\\'][^>]+content=[\"\\']([^\"\\']+)',\n        r'<img[^>]+src=[\"\\']([^\"\\']*(?:uploads|logo)[^\"\\']*\\.(?:png|jpe?g|webp)(?:\\.crdownload)?)',\n    ]\n    for p in pola:\n        m = re.search(p, text, re.I)\n        if m:\n            return urljoin(base, unescape(m.group(1)))\n    return None\n\n\ndef download(url: str, depth: int = 0):\n    \"\"\"Unduh gambar. Jika URL berupa halaman web, cari gambarnya otomatis.\n    Return (bytes, error).\"\"\"\n    origin = \"{u.scheme}://{u.netloc}/\".format(u=urlparse(url))\n    kandidat = [url]\n    m = re.search(r\"instagram\\.com/(?:p|reel)/([A-Za-z0-9_-]+)\", url)\n    if m:   # Instagram: coba endpoint media dulu\n        kandidat = [f\"https://www.instagram.com/p/{m.group(1)}/media/?size=l\", url]\n\n    variasi = [\n        {\"User-Agent\": UA_BROWSER, \"Accept\": \"image/avif,image/webp,image/*,*/*;q=0.8\"},\n        {\"User-Agent\": UA_BROWSER, \"Referer\": origin, \"Accept\": \"text/html,image/*,*/*;q=0.8\"},\n        {\"User-Agent\": UA_CRAWLER, \"Accept\": \"text/html,*/*\"},\n    ]\n    last = \"tidak diketahui\"\n    for cand in kandidat:\n        for h in variasi:\n            try:\n                r = requests.get(cand, headers=h, timeout=8, allow_redirects=True)\n                if r.status_code != 200:\n                    last = f\"HTTP {r.status_code}\"\n                    continue\n                if sniff_mime(r.content):\n                    return r.content, None\n                if depth < 1 and \"text/html\" in r.headers.get(\"Content-Type\", \"\"):\n                    img_url = find_image_in_html(r.text, cand)\n                    if img_url:\n                        data, err = download(img_url, depth + 1)\n                        if data:\n                            return data, None\n                        last = err or last\n                        continue\n                last = \"respons bukan gambar (halaman diblokir / butuh login)\"\n            except Exception as e:\n                last = type(e).__name__\n    return None, last\n\n\ndef get_image(file: str, url: str, resize: bool, label: str,\n              recolor: bool = False, max_side: int = 900):\n    \"\"\"\n    Urutan: (1) file lokal valid -> (2) unduh lalu simpan -> (3) link langsung ke browser -> None.\n    Hasil disimpan di session_state agar tidak mengunduh ulang tiap rerun.\n    \"\"\"\n    cache = st.session_state.setdefault(\"_img_cache\", {})\n    status = st.session_state.setdefault(\"_img_status\", {})\n    if file in cache:\n        return cache[file]\n\n    path = os.path.join(ASSETS, file)\n\n    def selesai(data: bytes):\n        if recolor:\n            data = recolor_logo(data)\n        cache[file] = to_uri(data)\n        status[file] = {\"label\": label, \"mode\": \"ok\", \"err\": \"\"}\n        return cache[file]\n\n    # 1) file lokal\n    if os.path.exists(path):\n        with open(path, \"rb\") as f:\n            data = f.read()\n        if sniff_mime(data):\n            if resize and len(data) > 400_000:\n                data = shrink(data, max_side)\n            return selesai(data)\n        os.remove(path)   # file rusak -> hapus\n\n    # 2) unduh dari URL\n    real = clean_url(url)\n    err = \"URL kosong\"\n    if real:\n        data, err = download(real)\n        if data:\n            if resize:\n                data = shrink(data, max_side)\n            with open(path, \"wb\") as f:\n                f.write(data)\n            return selesai(data)\n\n        # 3) fallback: biarkan browser memuat (hanya jika benar-benar link gambar)\n        if looks_like_image(real) and not recolor:\n            cache[file] = real\n            status[file] = {\"label\": label, \"mode\": \"hotlink\", \"err\": err}\n            return real\n\n    status[file] = {\"label\": label, \"mode\": \"gagal\", \"err\": err}\n    return None\n\n\ndef reset_image_cache():\n    st.session_state.pop(\"_img_cache\", None)\n    st.session_state.pop(\"_img_status\", None)\n\n\n# ============================================================\n# CSS\n# ============================================================\nhtml(\"\"\"\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\nhtml, body, [class*=\"css\"], .stApp {font-family:'Plus Jakarta Sans',sans-serif;}\n.stApp {background:linear-gradient(180deg,#f1f5f9 0%,#ffffff 40%,#f8fafc 100%);}\n.block-container {max-width:1150px; padding-top:1.4rem; padding-bottom:2rem;}\n#MainMenu, footer, header {visibility:hidden;}\n\n/* ---------- LOGO ATAS ---------- */\n.logostrip {display:inline-flex; align-items:center; gap:18px; padding:.6rem 1.2rem;\n            background:#fff; border:1px solid #e2e8f0; border-radius:18px;\n            box-shadow:0 6px 18px rgba(15,23,42,.07); margin-bottom:1rem;}\n.logostrip img {object-fit:contain; display:block;}\n.logostrip .dk {background:linear-gradient(135deg,#0a1a33,#10294d); border-radius:12px;\n                padding:6px 12px; display:flex; align-items:center;}\n.logostrip .sep {width:1px; height:34px; background:#e2e8f0;}\n.logofb {font-size:1.6rem; letter-spacing:6px;}\n\n/* ---------- HEADER ---------- */\n.hcard {background:#fff; border:1px solid #e2e8f0; border-radius:22px; padding:1.7rem 1.8rem;\n        box-shadow:0 10px 30px rgba(15,23,42,.07); min-height:250px;}\n.hcard h1 {margin:0 0 .8rem 0; font-size:2.05rem; line-height:1.2; font-weight:800; color:#0f172a;}\n.hcard p {margin:0 0 1rem 0; color:#475569; font-size:.92rem; line-height:1.6;}\n.chip {display:inline-block; margin:0 8px 6px 0; padding:6px 14px; border-radius:999px;\n       background:#f8fafc; border:1px solid #e2e8f0; color:#475569; font-size:.78rem;}\n.chip b {color:#0f172a;}\n\n.rcard {background:rgba(255,255,255,.95); border:1px solid #e2e8f0; border-radius:22px;\n        padding:1.5rem 1.6rem; box-shadow:0 10px 30px rgba(15,23,42,.07); min-height:250px;}\n.rcard h4 {margin:0 0 .6rem 0; color:#0f172a; font-size:1rem; font-weight:800;}\n.rcard p {margin:0 0 1rem 0; color:#475569; font-size:.86rem; line-height:1.6;}\n.mini {display:grid; grid-template-columns:1fr 1fr; gap:12px;}\n.mini div {border:1px solid #e2e8f0; border-radius:14px; padding:.7rem .9rem; background:#fff;}\n.mini small {display:block; color:#64748b; font-size:.72rem; font-weight:600;}\n.mini b {color:#0f172a; font-size:1rem;}\n\n/* ---------- WADAH HERO (biru muda -> putih) ---------- */\n.herowrap {display:grid; grid-template-columns:1.5fr 1fr; gap:1.4rem; align-items:stretch;\n           padding:1.5rem; border-radius:30px; border:1px solid #bfdbfe;\n           background:linear-gradient(135deg,#bae6fd 0%,#e0f2fe 45%,#ffffff 100%);\n           box-shadow:0 14px 40px rgba(2,132,199,.14);}\n.herowrap .hcard, .herowrap .rcard {min-height:0; height:100%; box-sizing:border-box;\n           background:rgba(255,255,255,.92); border:1px solid rgba(186,230,253,.9);\n           box-shadow:0 8px 24px rgba(15,23,42,.06);}\n.herowrap .rcard {display:flex; flex-direction:column;}\n.herowrap .rcard .mini {margin-top:auto;}\n@media (max-width: 800px) {.herowrap {grid-template-columns:1fr;}}\n\n/* ---------- SECTION ---------- */\n.sec {margin:2.4rem 0 1rem 0;}\n.sec h2 {margin:0; font-size:1.4rem; font-weight:800; color:#0f172a;}\n.sec h2::after {content:\"\"; display:block; width:54px; height:4px; border-radius:4px; margin-top:6px;\n        background:linear-gradient(90deg,#0284c7,#0d9488);}\n.sec span {color:#64748b; font-size:.86rem;}\n\n/* ---------- PETA ---------- */\niframe {border-radius:22px; border:1px solid #e2e8f0 !important;\n        box-shadow:0 10px 30px rgba(15,23,42,.10);}\n.legend {display:flex; flex-wrap:wrap; gap:8px; margin-top:.8rem;}\n.legend span {display:inline-flex; align-items:center; gap:6px; background:#fff;\n       border:1px solid #e2e8f0; border-radius:999px; padding:5px 13px; font-size:.78rem;\n       color:#334155; font-weight:600;}\n.legend i {width:10px; height:10px; border-radius:50%; display:inline-block;}\n\n/* ---------- KARTU DESTINASI ---------- */\n.dest {background:#fff; border:1px solid #e2e8f0; border-radius:22px; overflow:hidden;\n       box-shadow:0 4px 14px rgba(15,23,42,.06); transition:.3s; margin-bottom:1rem;}\n.dest:hover {transform:translateY(-6px); box-shadow:0 18px 36px rgba(2,132,199,.18);}\n.dest .pic {height:175px; display:flex; align-items:center; justify-content:center;\n       font-size:3.2rem; position:relative; overflow:hidden;}\n.dest .pic img.pimg {position:absolute; inset:0; width:100%; height:100%; object-fit:cover;}\n.dest .tag {position:absolute; top:12px; left:12px; z-index:2; background:rgba(255,255,255,.92);\n       color:#0369a1; font-size:.7rem; font-weight:700; padding:4px 10px; border-radius:999px;}\n.dest .body {padding:1rem 1.1rem 1.2rem 1.1rem;}\n.dest h4 {margin:0 0 .3rem 0; color:#0f172a; font-size:1rem;}\n.dest p {margin:0; color:#64748b; font-size:.82rem;}\n\n/* ---------- CTA & LOGIN ---------- */\n.cta {text-align:center; border-radius:26px; padding:2.4rem 1.5rem; margin-top:2.4rem; color:#fff;\n      background:linear-gradient(135deg,#0f172a 0%,#0369a1 60%,#0d9488 100%);\n      box-shadow:0 18px 40px rgba(15,23,42,.25);}\n.cta h3 {margin:0 0 .4rem 0; color:#fff; font-size:1.5rem; font-weight:800;}\n.cta p {margin:0; color:rgba(255,255,255,.85); font-size:.92rem;}\n\n.lcard {background:#fff; border:1px solid #e2e8f0; border-radius:22px; padding:1.5rem;\n        box-shadow:0 10px 28px rgba(15,23,42,.08); margin-bottom:.8rem;}\n.lcard h3 {margin:0 0 .3rem 0; color:#0f172a;}\n.lcard p {margin:0; color:#64748b; font-size:.88rem;}\n\n.dash {background:linear-gradient(135deg,#0369a1,#0d9488); color:#fff; border-radius:22px;\n       padding:1.4rem 1.6rem; box-shadow:0 14px 34px rgba(2,132,199,.25); margin-bottom:1rem;}\n.dash h2 {margin:0; color:#fff; font-size:1.5rem; font-weight:800;}\n.dash span {color:rgba(255,255,255,.88); font-size:.88rem;}\n\ndiv.stButton > button, div.stFormSubmitButton > button {\n    background:linear-gradient(90deg,#0284c7,#0d9488); color:#fff; border:none;\n    border-radius:14px; padding:.75rem 1rem; font-weight:700; width:100%;\n    box-shadow:0 8px 20px rgba(2,132,199,.30); transition:.2s;}\ndiv.stButton > button:hover, div.stFormSubmitButton > button:hover {\n    color:#fff; transform:translateY(-2px); box-shadow:0 12px 26px rgba(2,132,199,.40);}\n.footer {text-align:center; color:#94a3b8; font-size:.78rem; margin-top:2.2rem;}\n</style>\n\"\"\")\n\n\n# ============================================================\n# KOMPONEN\n# ============================================================\ndef logo_strip() -> str:\n    items = []\n    for lg in LOGOS:\n        src = get_image(lg[\"file\"], lg[\"url\"], True, \"Logo \" + lg[\"file\"],\n                        recolor=lg.get(\"recolor\", False), max_side=500)\n        if not src:\n            continue\n        img = (f'<img src=\"{src}\" alt=\"\" referrerpolicy=\"no-referrer\" '\n               f'style=\"height:{lg[\"h\"]}px;\"/>')\n        items.append(f'<div class=\"dk\">{img}</div>' if lg[\"dark\"] else img)\n    if not items:\n        return '<div class=\"logostrip\"><span class=\"logofb\">🎓 🏛️ 🌴</span></div>'\n    return '<div class=\"logostrip\">' + '<div class=\"sep\"></div>'.join(items) + \"</div>\"\n\n\ndef render_peta():\n    if PETA_STYLE == \"google\":\n        m = folium.Map(location=[-7.05, 112.83], zoom_start=10, control_scale=True,\n                       tiles=\"https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}&hl=id\",\n                       attr=\"Google Maps\")\n    else:\n        m = folium.Map(location=[-7.05, 112.83], zoom_start=10, tiles=\"OpenStreetMap\",\n                       control_scale=True)\n\n    for d in DESTINASI:\n        pin = f\"\"\"\n        <div style=\"position:relative; width:30px; height:42px; transform:translate(-15px,-40px);\">\n          <svg viewBox=\"0 0 30 42\" width=\"30\" height=\"42\" xmlns=\"http://www.w3.org/2000/svg\"\n               style=\"filter:drop-shadow(0 3px 3px rgba(0,0,0,.35));\">\n            <path d=\"M15 0C6.7 0 0 6.7 0 15c0 11 15 27 15 27s15-16 15-27C30 6.7 23.3 0 15 0z\"\n                  fill=\"{d['color']}\" stroke=\"white\" stroke-width=\"2\"/>\n            <circle cx=\"15\" cy=\"15\" r=\"6\" fill=\"white\"/>\n          </svg>\n        </div>\n        \"\"\"\n        folium.Marker(\n            location=[d[\"lat\"], d[\"lon\"]],\n            icon=folium.DivIcon(html=pin, icon_size=(0, 0)),\n            tooltip=folium.Tooltip(\n                f\"<b>{d['nama']}</b>\", permanent=True, direction=\"right\",\n                style=\"background:white;color:#0f172a;border-radius:8px;\"\n                      \"border:1px solid #e2e8f0;padding:3px 8px;font-size:12px;\"\n                      \"box-shadow:0 2px 6px rgba(0,0,0,.2);margin-left:10px;\"),\n            popup=folium.Popup(\n                f\"<b>{d['nama']}</b><br><span style='color:#64748b'>{d['tag']}</span>\",\n                max_width=220),\n        ).add_to(m)\n\n    m.fit_bounds([[d[\"lat\"], d[\"lon\"]] for d in DESTINASI], padding=(40, 40))\n    peta_html = m.get_root().render()\n    if hasattr(st, \"iframe\"):          # Streamlit baru (components.html sudah dihapus)\n        st.iframe(peta_html, height=480)\n    else:\n        components.html(peta_html, height=480)\n\n    legend = \"\".join(\n        f'<span><i style=\"background:{d[\"color\"]}\"></i>{d[\"nama\"]}</span>' for d in DESTINASI)\n    html(f'<div class=\"legend\">{legend}</div>')\n\n\ndef dest_card(d: dict) -> str:\n    src = get_image(d[\"file\"], d[\"url\"], True, d[\"nama\"])\n    grad = f'linear-gradient(135deg,{d[\"grad\"]})'\n    img = (f'<img class=\"pimg\" src=\"{src}\" alt=\"\" referrerpolicy=\"no-referrer\"/>'\n           if src else \"\")\n    return f\"\"\"\n    <div class=\"dest\">\n    <div class=\"pic\" style=\"background-image:{grad};\"><span class=\"tag\">{d['tag']}</span>{d['icon']}{img}</div>\n    <div class=\"body\"><h4>{d['nama']}</h4><p>{d['desk']}</p></div>\n    </div>\n    \"\"\"\n\n\ndef section(title: str, sub: str = \"\"):\n    html(f'<div class=\"sec\"><h2>{title}</h2><span>{sub}</span></div>')\n\n\ndef panel_status_gambar():\n    \"\"\"Panel info + upload manual untuk gambar/logo yang belum termuat dari server.\"\"\"\n    status = st.session_state.get(\"_img_status\", {})\n    masalah = {f: s for f, s in status.items() if s[\"mode\"] != \"ok\"}\n    if not masalah:\n        return\n\n    with st.expander(f\"ℹ️ {len(masalah)} gambar belum diunduh server (klik untuk upload manual)\"):\n        st.caption(\n            \"Instagram dan beberapa situs memblokir unduhan otomatis. Simpan fotonya dari \"\n            \"browser/HP Anda, lalu upload di bawah. Hasil upload tersimpan di folder assets/.\")\n        for file, s in masalah.items():\n            st.markdown(f\"**{s['label']}** · status: `{s['mode']}` · alasan: `{s['err']}`\")\n            up = st.file_uploader(f\"Upload untuk {file}\", type=[\"jpg\", \"jpeg\", \"png\", \"webp\"],\n                                  key=f\"up_{file}\")\n            if up is not None:\n                data = up.getvalue()\n                if sniff_mime(data):\n                    with open(os.path.join(ASSETS, file), \"wb\") as f:\n                        f.write(data)\n                    reset_image_cache()\n                    st.rerun()\n                else:\n                    st.error(\"File bukan gambar yang valid.\")\n        if st.button(\"🔄 Coba muat ulang semua gambar\", key=\"btn_retry\"):\n            reset_image_cache()\n            st.rerun()\n\n\n# ============================================================\n# HALAMAN: LANDING\n# ============================================================\ndef landing_page():\n    html(logo_strip())\n\n    # ---------- HERO (2 card dalam wadah biru muda -> putih) ----------\n    html(f\"\"\"\n    <div class=\"herowrap\">\n    <div class=\"hcard\">\n    <h1>Aplikasi Prediksi Jumlah Kunjungan Wisatawan<br>Di Kabupaten Bangkalan</h1>\n    <p>Dikembangkan oleh <b>{NAMA_PENGEMBANG}</b> sebagai Tugas Akhir S1 Sistem Informasi.\n    Sistem memanfaatkan metode hybrid <b>ICEEMDAN-VMD-GRU</b> untuk membantu analisis\n    tren kunjungan wisata.</p>\n    <span class=\"chip\">Metode: <b>ICEEMDAN-VMD</b></span>\n    <span class=\"chip\">Model: <b>GRU</b></span>\n    <span class=\"chip\">Output: <b>Prediksi Kunjungan</b></span>\n    </div>\n    <div class=\"rcard\">\n    <h4>Ringkasan Metode</h4>\n    <p>Kombinasi <b>ICEEMDAN</b> dan <b>Variational Mode Decomposition (VMD)</b> untuk\n    dekomposisi sinyal dan <b>Gated Recurrent Unit (GRU)</b> untuk pemodelan deret waktu,\n    sehingga prediksi lebih stabil terhadap noise dan pola musiman.</p>\n    <div class=\"mini\">\n    <div><small>Cakupan</small><b>Kab. Bangkalan</b></div>\n    <div><small>Destinasi</small><b>{len(DESTINASI)} Lokasi</b></div>\n    </div>\n    </div>\n    </div>\n    \"\"\")\n\n    # ---------- PETA ----------\n    section(\"Wilayah Cakupan Kabupaten Bangkalan\", \"Pin berwarna menandai lokasi objek wisata\")\n    render_peta()\n\n    # ---------- DESTINASI ----------\n    section(\"Destinasi Wisata yang Diprediksi\", f\"{len(DESTINASI)} lokasi wisata ditampilkan\")\n    r1 = st.columns(3, gap=\"medium\")\n    for col, d in zip(r1, DESTINASI[:3]):\n        with col:\n            html(dest_card(d))\n    r2 = st.columns(3, gap=\"medium\")\n    for col, d in zip(r2, DESTINASI[3:]):\n        with col:\n            html(dest_card(d))\n\n    # ---------- CTA ----------\n    html(\"\"\"\n    <div class=\"cta\">\n    <h3>Siap mulai analisis prediksi?</h3>\n    <p>Silakan login sebagai Admin atau User untuk mengakses fitur peramalan kunjungan wisatawan.</p>\n    </div>\n    \"\"\")\n    st.write(\"\")\n    _, mid, _ = st.columns([1, 1.2, 1])\n    with mid:\n        if st.button(\"🔐 Login Admin atau User\", key=\"btn_login\"):\n            goto(\"login\")\n\n    html(f'<div class=\"footer\">© 2026 {NAMA_PENGEMBANG} — Aplikasi Prediksi Kunjungan '\n         'Wisatawan Kabupaten Bangkalan, Tugas Akhir. All rights reserved.</div>')\n\n    panel_status_gambar()\n\n\n# ============================================================\n# HALAMAN: LOGIN\n# ============================================================\ndef login_page():\n    html(\"\"\"\n    <div class=\"hcard\" style=\"text-align:center; min-height:0;\">\n    <h1 style=\"margin:0;\">Selamat Datang 👋</h1>\n    <p style=\"margin:.5rem 0 0 0;\">Pilih cara masuk untuk melanjutkan ke aplikasi peramalan.</p>\n    </div>\n    \"\"\")\n    st.write(\"\")\n    cu, ca = st.columns(2, gap=\"large\")\n\n    # ----- USER: langsung masuk tanpa input -----\n    with cu:\n        html(\"\"\"\n        <div class=\"lcard\"><h3>👤 User</h3>\n        <p>Masuk langsung tanpa username dan password untuk melihat serta menjalankan peramalan.</p></div>\n        \"\"\")\n        if st.button(\"Masuk sebagai User\", key=\"btn_user\"):\n            goto(\"app_user\", role=\"User\")\n\n    # ----- ADMIN: username & password -----\n    with ca:\n        html(\"\"\"\n        <div class=\"lcard\"><h3>🛠️ Admin</h3>\n        <p>Masuk dengan akun admin untuk mengelola data dan model.</p></div>\n        \"\"\")\n        with st.form(\"form_admin\"):\n            u = st.text_input(\"Username\")\n            p = st.text_input(\"Password\", type=\"password\")\n            ok = st.form_submit_button(\"Masuk sebagai Admin\")\n        if ok:\n            if u == ADMIN_USER and p == ADMIN_PASS:\n                goto(\"app_admin\", role=\"Admin\")\n            else:\n                st.error(\"Username atau password salah.\")\n\n    st.write(\"\")\n    _, mid, _ = st.columns([1, 1, 1])\n    with mid:\n        if st.button(\"⬅️ Kembali ke Beranda\", key=\"btn_back\"):\n            goto(\"landing\")\n\n\n# ============================================================\n# HALAMAN: USER  (Dashboard Prediksi)\n# ============================================================\nimport inspect\nimport pandas as pd\nimport plotly.graph_objects as go\nimport forecasting_engine as fe\n\nBULAN_PENDEK = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"Mei\", \"Jun\", \"Jul\", \"Agu\", \"Sep\", \"Okt\", \"Nov\", \"Des\"]\n\nDASH_CSS = \"\"\"\n<style>\n/* header Streamlit tetap ada (tombol sidebar di HP), hanya toolbar disembunyikan */\nheader[data-testid=\"stHeader\"] {visibility:visible !important; background:transparent !important;}\n[data-testid=\"stToolbar\"], [data-testid=\"stDecoration\"] {display:none !important;}\n.block-container {max-width:1250px;}\n\n/* ================= SIDEBAR: TETAP TERLIHAT, RAPAT, TANPA SCROLL ================= */\n/* Sembunyikan tombol buka/tutup sidebar (hanya di layar lebar; di HP tetap bisa dibuka) */\n/* ================= SIDEBAR ================= */\n@media (min-width: 992px) {\n    [data-testid=\"stSidebarCollapseButton\"],\n    [data-testid=\"stSidebarCollapsedControl\"],\n    [data-testid=\"collapsedControl\"],\n    [data-testid=\"stExpandSidebarButton\"] {display:none !important;}\n    section[data-testid=\"stSidebar\"] {\n        width:310px !important; min-width:310px !important; max-width:310px !important;\n        transform:none !important; visibility:visible !important;}\n    [data-testid=\"stSidebarResizeHandle\"] {display:none !important;}\n}\nsection[data-testid=\"stSidebar\"] {background:#f8fafc !important; border-right:1px solid #e2e8f0;}\n[data-testid=\"stSidebarHeader\"] {display:none !important;}\n[data-testid=\"stSidebarUserContent\"] {padding:1.1rem 1rem .8rem 1rem !important;}\nsection[data-testid=\"stSidebar\"] [data-testid=\"stVerticalBlock\"] {gap:.6rem !important;}\n\n.sb-title {font-size:1.05rem; font-weight:800; color:#0f172a; padding-bottom:.65rem;\n           border-bottom:1px solid #e2e8f0; margin-bottom:.1rem;}\n\nsection[data-testid=\"stSidebar\"] [data-testid=\"stWidgetLabel\"] p {\n    font-size:.7rem !important; font-weight:800 !important; letter-spacing:.07em !important;\n    text-transform:uppercase !important; color:#64748b !important;}\n\nsection[data-testid=\"stSidebar\"] div[role=\"radiogroup\"] {gap:.18rem !important;}\nsection[data-testid=\"stSidebar\"] div[role=\"radiogroup\"] > label {\n    width:100% !important; margin:0 !important; padding:.4rem .65rem !important;\n    border-radius:10px !important; border:1px solid transparent !important; transition:.15s;}\nsection[data-testid=\"stSidebar\"] div[role=\"radiogroup\"] > label:hover {background:#eef6fd !important;}\nsection[data-testid=\"stSidebar\"] div[role=\"radiogroup\"] > label:has(input:checked) {\n    background:#e0f2fe !important; border-color:#bae6fd !important;}\nsection[data-testid=\"stSidebar\"] div[role=\"radiogroup\"] > label p {\n    font-size:.86rem !important; line-height:1.25 !important; margin:0 !important;\n    color:#334155 !important; text-transform:none !important; letter-spacing:0 !important;\n    font-weight:500 !important;}\nsection[data-testid=\"stSidebar\"] div[role=\"radiogroup\"] > label:has(input:checked) p {\n    color:#0369a1 !important; font-weight:700 !important;}\n\nsection[data-testid=\"stSidebar\"] [data-testid=\"stFileUploaderDropzone\"] {\n    flex-direction:column !important; align-items:stretch !important; gap:.55rem !important;\n    padding:.75rem !important; background:#ffffff !important;\n    border:1.5px dashed #93c5fd !important; border-radius:12px !important;}\nsection[data-testid=\"stSidebar\"] [data-testid=\"stFileUploaderDropzoneInstructions\"] {\n    justify-content:center !important; text-align:center !important;}\nsection[data-testid=\"stSidebar\"] [data-testid=\"stFileUploaderDropzoneInstructions\"] span,\nsection[data-testid=\"stSidebar\"] [data-testid=\"stFileUploaderDropzoneInstructions\"] small {\n    font-size:.72rem !important; color:#64748b !important;}\nsection[data-testid=\"stSidebar\"] [data-testid=\"stFileUploaderDropzone\"] button {\n    width:100% !important; justify-content:center !important; background:#ffffff !important;\n    color:#0369a1 !important; border:1px solid #bae6fd !important; border-radius:10px !important;\n    font-weight:700 !important;}\n\nsection[data-testid=\"stSidebar\"] [data-testid=\"stElementContainer\"]:has(div.stButton) {width:100% !important;}\nsection[data-testid=\"stSidebar\"] div.stButton {width:100% !important; margin:0 !important;}\nsection[data-testid=\"stSidebar\"] div.stButton > button {\n    width:100% !important; min-height:2.6rem !important; padding:.5rem 1rem !important;\n    border-radius:12px !important; justify-content:center !important; text-align:center !important;\n    box-shadow:0 4px 12px rgba(2,132,199,.25) !important; transform:none !important;}\nsection[data-testid=\"stSidebar\"] div.stButton > button p {\n    font-size:.9rem !important; font-weight:700 !important; margin:0 !important;}\nsection[data-testid=\"stSidebar\"] div.stButton > button:hover {\n    filter:brightness(1.05); box-shadow:0 6px 16px rgba(2,132,199,.35) !important;}\nsection[data-testid=\"stSidebar\"] div.stButton > button:disabled {\n    background:#e2e8f0 !important; color:#94a3b8 !important; box-shadow:none !important;\n    opacity:1 !important; cursor:not-allowed !important; filter:none !important;}\n\nsection[data-testid=\"stSidebar\"] .st-key-adm_back button,\nsection[data-testid=\"stSidebar\"] .st-key-dash_back button {\n    background:#ffffff !important; color:#334155 !important;\n    border:1px solid #cbd5e1 !important; box-shadow:none !important;}\nsection[data-testid=\"stSidebar\"] .st-key-adm_back button:hover,\nsection[data-testid=\"stSidebar\"] .st-key-dash_back button:hover {\n    border-color:#0284c7 !important; color:#0284c7 !important; background:#f0f9ff !important;\n    box-shadow:none !important;}\n\nsection[data-testid=\"stSidebar\"] .st-key-adm_go,\nsection[data-testid=\"stSidebar\"] .st-key-dash_go {\n    position:sticky; bottom:0; z-index:5; padding:.5rem 0 .3rem 0; background:#f8fafc;}\n\n/* ---------- HEADER DASHBOARD ---------- */\n.dwrap {position:relative; margin-bottom:1.1rem;}\n.dhead {max-width:720px; margin:0 auto; padding:1.1rem 1.6rem 1.3rem 1.6rem; border-radius:24px;\n        background:linear-gradient(135deg,#bae6fd 0%,#eff9ff 55%,#ffffff 100%);\n        border:1px solid #dbeafe; box-shadow:0 12px 30px rgba(2,132,199,.14);}\n.dlogos {display:inline-flex; align-items:center; gap:12px; background:#fff; border-radius:14px;\n         padding:.4rem .8rem; box-shadow:0 3px 10px rgba(15,23,42,.08); margin-bottom:.8rem;}\n.dlogos img {display:block; object-fit:contain;}\n.dhead h1 {margin:0; font-size:1.7rem; font-weight:800; color:#0f172a; line-height:1.25;}\n.dhead h2 {margin:.1rem 0 0 0; font-size:1.45rem; font-weight:800; color:#0f172a; line-height:1.25;}\n.dbadge {position:absolute; right:0; top:0; background:#fff; border-radius:14px; padding:.45rem .6rem;\n         box-shadow:0 3px 10px rgba(15,23,42,.10);}\n.dbadge img {display:block; object-fit:contain;}\n@media (max-width: 900px) {.dbadge {display:none;}}\n\n/* ---------- INFO & PLACEHOLDER ---------- */\n.dinfo {background:#e8f1fd; color:#1e3a8a; border-radius:10px; padding:.75rem 1rem; font-size:.84rem;\n        margin:.4rem 0 1rem 0;}\n.sk {background:#f1f5f9; border-radius:18px;}\n.sk-row {display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1rem;}\n\n/* ---------- KARTU METRIK ---------- */\n.mcard {background:#fff; border:1px solid #e2e8f0; border-radius:18px; padding:1rem 1.3rem;\n        box-shadow:0 6px 18px rgba(15,23,42,.06); margin-bottom:1rem;}\n.mcard .ml {color:#64748b; font-size:.78rem; font-weight:700; letter-spacing:.3px;}\n.mcard .mv {color:#0f172a; font-size:2rem; font-weight:800; line-height:1.2; margin:.15rem 0;}\n.mcard .ms {color:#64748b; font-size:.78rem;}\n.mcard.a {border-top:4px solid #0284c7;}\n.mcard.b {border-top:4px solid #0d9488;}\n\n/* ---------- KARTU GRAFIK ---------- */\ndiv[data-testid=\"stVerticalBlockBorderWrapper\"] {border-radius:18px;}\n.ct {font-weight:800; color:#0f172a; font-size:1.05rem; margin:0;}\n.cs {color:#64748b; font-size:.8rem; margin:.1rem 0 .4rem 0;}\n.dfooter {text-align:center; color:#64748b; font-size:.74rem; margin-top:2.2rem; padding-top:.9rem;\n          border-top:1px solid #e2e8f0;}\n</style>\n\"\"\"\n\n\ndef _fmt_id(x, dec=0):\n    s = f\"{x:,.{dec}f}\"\n    return s.replace(\",\", \"X\").replace(\".\", \",\").replace(\"X\", \".\")\n\n\ndef _tgl_id(iso):\n    d = pd.Timestamp(iso)\n    return f\"{BULAN_PENDEK[d.month - 1]} {d.year}\"\n\n\ndef _show(obj, kind=\"plot\", **kw):\n    \"\"\"Kompatibel lintas versi Streamlit (width='stretch' vs use_container_width).\"\"\"\n    fn = st.plotly_chart if kind == \"plot\" else st.dataframe\n    if \"width\" in inspect.signature(fn).parameters:\n        return fn(obj, width=\"stretch\", **kw)\n    return fn(obj, use_container_width=True, **kw)\n\n\ndef _logo_img(lg, h=None):\n    src = get_image(lg[\"file\"], lg[\"url\"], True, \"Logo \" + lg[\"file\"],\n                    recolor=lg.get(\"recolor\", False), max_side=500)\n    if not src:\n        return \"\"\n    return f'<img src=\"{src}\" alt=\"\" referrerpolicy=\"no-referrer\" style=\"height:{h or lg[\"h\"]}px;\"/>'\n\n\ndef dash_header():\n    logos = \"\".join(_logo_img(lg) for lg in LOGOS)   # semua logo, termasuk Bangkalan\n    html(f\"\"\"\n    <div class=\"dwrap\">\n    <div class=\"dhead\">\n    <div class=\"dlogos\">{logos or \"🎓 🏛️\"}</div>\n    <h1>Dashboard Prediksi</h1>\n    <h2>Analisis Data Kunjungan dan Peramalan Masa Depan</h2>\n    </div>\n    </div>\n    \"\"\")\n\n\ndef dash_footer():\n    html(f'<div class=\"dfooter\">© 2026 {NAMA_PENGEMBANG} - Tugas Akhir S1 Sistem Informasi UTM. '\n         'All rights reserved.</div>')\n\n\ndef dash_info(teks):\n    html(f'<div class=\"dinfo\">{teks}</div>')\n\n\ndef dash_skeleton():\n    html(\"\"\"\n    <div class=\"sk-row\"><div class=\"sk\" style=\"height:96px\"></div><div class=\"sk\" style=\"height:96px\"></div></div>\n    <div class=\"sk\" style=\"height:260px\"></div>\n    \"\"\")\n\n\ndef _metric_card(cls, label, nilai, sub):\n    return (f'<div class=\"mcard {cls}\"><div class=\"ml\">{label}</div>'\n            f'<div class=\"mv\">{nilai}</div><div class=\"ms\">{sub}</div></div>')\n\n\ndef _layout(fig, h=380):\n    fig.update_layout(\n        height=h, margin=dict(l=8, r=8, t=8, b=8), plot_bgcolor=\"#ffffff\", paper_bgcolor=\"#ffffff\",\n        font=dict(family=\"Plus Jakarta Sans, sans-serif\", size=12, color=\"#334155\"),\n        legend=dict(orientation=\"h\", yanchor=\"bottom\", y=1.02, xanchor=\"left\", x=0),\n        hovermode=\"x unified\",\n        xaxis=dict(showgrid=False, tickformat=\"%Y\", dtick=\"M12\", linecolor=\"#cbd5e1\"),\n        yaxis=dict(title=\"Jumlah Pengunjung\", gridcolor=\"#e2e8f0\", tickformat=\",.0f\", zeroline=False),\n    )\n    return fig\n\n\ndef fig_aktual_prediksi(h):\n    tgl = pd.to_datetime(h[\"tgl_hist\"])\n    tgl_uji = pd.to_datetime(h[\"tgl_uji\"])\n    fig = go.Figure()\n    fig.add_vrect(x0=tgl_uji[0], x1=tgl_uji[-1], fillcolor=\"rgba(249,115,22,0.07)\", line_width=0,\n                  annotation_text=\"Periode uji\", annotation_position=\"top left\",\n                  annotation_font=dict(size=11, color=\"#c2410c\"))\n    fig.add_trace(go.Scatter(\n        x=tgl, y=h[\"aktual_hist\"], name=\"Aktual\", mode=\"lines\",\n        line=dict(color=\"#0284c7\", width=2.4),\n        customdata=[_tgl_id(d.strftime(\"%Y-%m-%d\")) for d in tgl],\n        hovertemplate=\"Aktual: %{y:,.0f}<extra></extra>\"))\n    fig.add_trace(go.Scatter(\n        x=tgl_uji, y=h[\"prediksi_uji\"], name=\"Prediksi\", mode=\"lines+markers\",\n        line=dict(color=\"#f97316\", width=2.4, dash=\"dash\"), marker=dict(size=6),\n        hovertemplate=\"Prediksi: %{y:,.0f}<extra></extra>\"))\n    return _layout(fig)\n\n\ndef fig_masa_depan(h):\n    n_tampil = 36\n    tgl = pd.to_datetime(h[\"tgl_hist\"])[-n_tampil:]\n    akt = h[\"aktual_hist\"][-n_tampil:]\n    tgl_f = pd.to_datetime(h[\"tgl_fut\"])\n    fig = go.Figure()\n    fig.add_vrect(x0=tgl_f[0], x1=tgl_f[-1], fillcolor=\"rgba(13,148,136,0.07)\", line_width=0,\n                  annotation_text=\"12 bulan ke depan\", annotation_position=\"top left\",\n                  annotation_font=dict(size=11, color=\"#0f766e\"))\n    fig.add_trace(go.Scatter(x=tgl, y=akt, name=\"Data historis\", mode=\"lines\",\n                             line=dict(color=\"#0284c7\", width=2.4),\n                             hovertemplate=\"Aktual: %{y:,.0f}<extra></extra>\"))\n    # garis penghubung titik terakhir historis -> prediksi pertama\n    fig.add_trace(go.Scatter(x=[tgl[-1], tgl_f[0]], y=[akt[-1], h[\"prediksi_fut\"][0]],\n                             mode=\"lines\", showlegend=False, hoverinfo=\"skip\",\n                             line=dict(color=\"#0d9488\", width=1.6, dash=\"dot\")))\n    fig.add_trace(go.Scatter(x=tgl_f, y=h[\"prediksi_fut\"], name=\"Prediksi 12 bulan\",\n                             mode=\"lines+markers\", line=dict(color=\"#0d9488\", width=2.6, dash=\"dash\"),\n                             marker=dict(size=7),\n                             hovertemplate=\"Prediksi: %{y:,.0f}<extra></extra>\"))\n    fig.update_xaxes(tickformat=\"%b %Y\", dtick=\"M6\")\n    return _layout(fig)\n\n\ndef render_hasil(h):\n    c1, c2 = st.columns(2, gap=\"medium\")\n    with c1:\n        html(_metric_card(\"a\", \"MAE (Mean Absolute Error)\", _fmt_id(h[\"mae\"], 2),\n                          \"rata-rata selisih absolut aktual dan prediksi\"))\n    with c2:\n        html(_metric_card(\"b\", \"MAPE (Mean Absolute Percentage Error)\", _fmt_id(h[\"mape\"], 2) + \"%\",\n                          \"rata-rata persentase kesalahan prediksi\"))\n\n    with st.container(border=True):\n        html(f'<div class=\"ct\">Visualisasi Data Aktual dan Prediksi</div>'\n             f'<div class=\"cs\">Evaluasi pada periode uji {_tgl_id(h[\"tgl_uji\"][0])} – '\n             f'{_tgl_id(h[\"tgl_uji\"][-1])} ({len(h[\"tgl_uji\"])} bulan)</div>')\n        _show(fig_aktual_prediksi(h), \"plot\", key=\"fig_aktual\")\n\n    st.write(\"\")\n    with st.container(border=True):\n        html(f'<div class=\"ct\">Prediksi Kunjungan 12 Bulan ke Depan</div>'\n             f'<div class=\"cs\">{_tgl_id(h[\"tgl_fut\"][0])} – {_tgl_id(h[\"tgl_fut\"][-1])}</div>')\n        _show(fig_masa_depan(h), \"plot\", key=\"fig_future\")\n        tabel = pd.DataFrame({\n            \"Bulan\": [_tgl_id(d) for d in h[\"tgl_fut\"]],\n            \"Prediksi Pengunjung\": [_fmt_id(v) for v in h[\"prediksi_fut\"]],\n        })\n        with st.expander(\"Lihat tabel prediksi\"):\n            _show(tabel, \"df\", hide_index=True)\n\n    if h.get(\"n_param_default\", 0) > 0:\n        st.caption(\"Catatan: pola data yang diunggah berbeda dari data acuan model, sehingga \"\n                   f\"{h['n_param_default']} komponen memakai pengaturan standar. Hasil dapat \"\n                   \"berbeda dari data acuan.\")\n\n\ndef user_page():\n    if st.session_state.role != \"User\":\n        goto(\"login\")\n\n    html(DASH_CSS)\n    names = [d[\"nama\"] for d in DESTINASI if d[\"nama\"] in fe.CONFIG]\n\n    # ---------------- SIDEBAR ----------------\n    with st.sidebar:\n        html('<div class=\"sb-title\">⚙️ Konfigurasi Prediksi</div>')\n        dest = st.radio(\"Destinasi Wisata\", names, key=\"dash_dest\",\n                        help=\"Pilih destinasi wisata yang akan diprediksi.\")\n        up = st.file_uploader(\"Dataset (.xlsx / .csv)\", type=[\"xlsx\", \"csv\"], key=\"dash_up\")\n        go_btn = st.button(\"Mulai Prediksi\", key=\"dash_go\", disabled=(up is None))\n        if st.button(\"« Kembali ke Beranda\", key=\"dash_back\"):\n            goto(\"landing\")\n\n    # ---------------- HALAMAN UTAMA ----------------\n    dash_header()\n\n    if up is None:\n        dash_info(\"Silakan unggah (upload) file dataset Excel/CSV melalui sidebar di sebelah \"\n                  \"kiri untuk memulai analisis.\")\n        dash_skeleton()\n        dash_footer()\n        return\n\n    data_bytes = up.getvalue()\n    try:\n        data_clean, info = fe.siapkan_data(fe.baca_dataset(data_bytes, up.name, destinasi=dest))\n    except Exception as e:\n        st.error(f\"Dataset tidak dapat dibaca: {e}\")\n        dash_footer()\n        return\n\n    key = fe.kunci_cache(dest, data_bytes)\n    clean_key = fe.kunci_cache(\n        dest,\n        pd.util.hash_pandas_object(\n            data_clean[[\"date\", \"visitors\"]].reset_index(drop=True), index=False\n        ).values.tobytes()\n    )\n\n    if go_btn:\n        hasil = fe.muat_cache(key) or fe.muat_cache(clean_key)\n        if hasil is None:\n            bar = st.progress(0.0, text=\"Memulai proses...\")\n            try:\n                hasil = fe.jalankan_prediksi(\n                    dest, data_clean, progress=lambda f, t: bar.progress(min(max(f, 0.0), 1.0), text=t))\n            except Exception as e:\n                bar.empty()\n                st.error(f\"Proses gagal dijalankan: {e}\")\n                dash_footer()\n                return\n            bar.empty()\n            fe.simpan_cache(key, hasil)\n            fe.simpan_cache(clean_key, hasil)\n        st.session_state[\"dash_result\"] = {\"key\": key, \"hasil\": hasil}\n\n    res = st.session_state.get(\"dash_result\")\n    if res and res[\"key\"] == key:\n        render_hasil(res[\"hasil\"])\n    else:\n        periode = f'{_tgl_id(info[\"awal\"].strftime(\"%Y-%m-%d\"))} – {_tgl_id(info[\"akhir\"].strftime(\"%Y-%m-%d\"))}'\n        dash_info(f'Dataset <b>{up.name}</b> diterima ({info[\"n\"]} bulan, {periode}). '\n                  'Klik <b>Mulai Prediksi</b> pada sidebar untuk menjalankan analisis.')\n        dash_skeleton()\n    dash_footer()\n\n\n# ============================================================\n# HALAMAN: ADMIN (Dashboard sama seperti User + pilihan metode)\n# ============================================================\nimport admin_methods as am\n\ndef admin_page():\n    if st.session_state.role != \"Admin\":\n        goto(\"login\")\n\n    html(DASH_CSS)\n    names = [d[\"nama\"] for d in DESTINASI if d[\"nama\"] in fe.CONFIG]\n\n    # ---------------- SIDEBAR ----------------\n    with st.sidebar:\n        html('<div class=\"sb-title\">⚙️ Konfigurasi Prediksi</div>')\n        dest = st.radio(\"Destinasi Wisata\", names, key=\"adm_dest\",\n                        help=\"Pilih destinasi wisata yang akan diprediksi.\")\n        metode = st.radio(\"Metode Peramalan\", am.METODE, key=\"adm_metode\",\n                          help=\"Pilih metode peramalan yang akan dijalankan.\")\n        up = st.file_uploader(\"Dataset (.xlsx / .csv)\", type=[\"xlsx\", \"csv\"], key=\"adm_up\")\n        go_btn = st.button(\"Mulai Prediksi\", key=\"adm_go\", disabled=(up is None))\n        if st.button(\"« Keluar\", key=\"adm_back\"):\n            goto(\"landing\")\n\n    # ---------------- HALAMAN UTAMA ----------------\n    dash_header()\n\n    if up is None:\n        dash_info(\"Silakan unggah (upload) file dataset Excel/CSV melalui sidebar di sebelah \"\n                 