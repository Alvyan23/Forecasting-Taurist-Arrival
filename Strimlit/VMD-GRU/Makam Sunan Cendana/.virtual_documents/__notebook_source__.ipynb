r += 1
r = table_header(ws2, r, ['Sinyal', 'K Optimal', 'Alpha Optimal', 'Korelasi', 'ELC', 'Bandwidth'])
df_summary = pd.DataFrame(vmd_summary_params)
for i, row in df_summary.iterrows():
