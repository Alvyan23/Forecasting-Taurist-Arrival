# VISUALISASI HASIL DEKOMPOSISI
# =========================
print(f'Plot hasil dekomposisi VMD untuk {signal_name} (K={best_k})')

n_imfs = best_k
fig, axes = plt.subplots(
    n_imfs + 1, 1, figsize=(12, 2 * (n_imfs + 1)), sharex=True
